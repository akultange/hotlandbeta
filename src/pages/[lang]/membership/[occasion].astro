---
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import PageTitle from '../../../components/PageTitle.astro';
import MemberCards from '../../../components/MemberCards.astro';
import { type Lang, ui, tr, langs } from '../../../data/i18n';
import { site } from '../../../data/site';
import { occasions, parties, vip, bookingFine, gallery, media, type Occasion } from '../../../data/content';

export function getStaticPaths() {
  return langs.flatMap((lang) => occasions.map((o) => ({ params: { lang, occasion: o.slug }, props: { o } })));
}
const lang = Astro.params.lang as Lang;
const { o } = Astro.props as { o: Occasion };
const t = ui[lang];
const ru = lang === 'ru';
const title = tr(o.title, lang);
const altOf = (file: string) => gallery.find((x) => x.img === file)?.alt;
const ratios = ['4/3', '1/1', '3/4'];
// The parties' title over the list of what comes with a party, in two lines as on the home page: "Ваш праздник,"
// and, after a break set here at the comma, the quiet "ваш сценарий", whose two words always stay together (a
// narrow measure used to do the breaking, and left "Ваш" alone on a line of its own).
const listTitle = tr(parties.title, lang)
  .replace(/<em>(.*?)<\/em>/, (_, s: string) => `<em>${s.replace(/ /g, '\u00a0')}</em>`)
  .replace(/,\s*(?=<em>)/, ',<br>');
// Russian typesetting: a short word stays on the line of the word after it ("за каждый", "без счёта"), and a
// hyphenated word never breaks at its hyphen ("караоке-зала").
const keep = (s: string) => (ru ? s.replace(/(?<=^|\s)(в|во|на|за|до|по|под|с|со|к|ко|и|а|о|у|не|ни|от|из|для|без)\s/gi, '$1\u00a0') : s).replace(/(\S)-(?=\S)/g, '$1\u2011');
// The request is the booking dialog (Book.astro), opened by a link to the booking page with a party and this
// occasion chosen, so it starts on its second step (a new tab opens the booking page with the same choice). Beside
// the request's words, its three steps, the first already done.
const occasion = (t.form.occasions as Record<string, string>)[o.slug];
const bookHref = `/${lang}/booking/?type=event${occasion ? `&occasion=${o.slug}` : ''}`;
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const requestSteps = [
  `${ru ? 'Праздник' : 'A party'}: ${lower(occasion ?? title)}`,
  ru ? 'Сколько вас и ваши пожелания' : 'How many of you, and your wishes',
  ru ? 'Как с вами связаться' : 'How we reach you',
];
---
<Base lang={lang} title={title} description={tr(o.text, lang)} waContext={title} closing={false}>
  <PageTitle
    crumbs={[{ href: `/${lang}/`, label: 'HOTLAND' }, { href: `/${lang}/membership/`, label: t.nav.vip }, { label: title }]}
    title={title}
    lead={tr(o.text, lang)}
    img={media(o.img)}
    imgAlt={tr(o.alt, lang)}
    band
  >
    <a class="btn btn-crimson" href={bookHref}>{tr(parties.cta, lang)}</a>
  </PageTitle>

  <!-- 01 Included -->
  <section class="sec">
    <div class="wrap">
      <div class="g12">
        <h2 class="t-l" style="grid-column: 1 / span 6" set:html={listTitle} />
        <div class="rows" style="grid-column: 8 / span 5; text-wrap: pretty">
          {parties.included.map((x, i) => <div class="row num"><span class="n">0{i + 1}</span><span class="k">{keep(tr(x, lang))}</span><span></span></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Membership: the three cards as on the home page, with the heading row (title, note and the link to the
       membership page) inside the field -->
  <section class="sec">
    <div class="wrap">
      <MemberCards lang={lang}>
        <div slot="head" class="bighead bh-line">
          <h2 class="t-l" set:html={tr(vip.title, lang)} />
          <div class="bighead-side">
            <p class="body">{keep(tr(vip.lead, lang))}</p>
            <a class="lnk" href={`/${lang}/membership/`}>{t.nav.vip}</a>
          </div>
        </div>
      </MemberCards>
    </div>
  </section>

  <section class="sec-t">
    <div class="wrap trio">
      {o.more.map((f, i) => {
        const alt = altOf(f);
        return <Photo src={media(f)} alt={alt ? tr(alt, lang) : ''} ratio={ratios[i]} />;
      })}
    </div>
  </section>

  <!-- 04 Request: the words; the three steps with the main button; the messengers. On a wide screen the words and
       the messengers stand on the left and the steps on the right; on a phone they come in that order, so the
       steps and the main button are met before the messengers. The first step is the one you are on. -->
  <section class="sec soot" id="request">
    <div class="wrap">
      <div class="g12">
        <div class="stack rq-words">
          <h2 class="t-l" set:html={ru ? 'Отправить <em>заявку</em>' : 'Send <em>a request</em>'} />
          <p class="body">{tr(bookingFine, lang)}</p>
        </div>
        <div class="stack rq-steps">
          <div class="rows">
            {requestSteps.map((s, i) => <div class="row num" aria-current={i === 0 ? 'step' : undefined}><span class="n">0{i + 1}</span><span class="k">{keep(s)}</span><span></span></div>)}
          </div>
          <div class="btns"><a class="btn btn-crimson" href={bookHref}>{ru ? 'Оставить заявку' : 'Enquire'}</a></div>
        </div>
        <div class="btns rq-msg">
          <a class="btn btn-line btn-sm" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn btn-line btn-sm" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The request block. A wide screen: the words and, under them, the messengers on the left; the steps and the main
     button on the right, beside both. One column (the same screens as every .g12, global.css): the words, the
     steps and the main button, then the messengers. */
  .rq-words { grid-column: 1 / span 4; }
  .rq-steps { grid-column: 6 / span 7; grid-row: 1 / span 2; }
  .rq-msg { grid-column: 1 / span 4; grid-row: 2; align-self: start; margin-top: 24px; }
  @media (max-width: 639px), (max-width: 899px) and (orientation: portrait), (max-width: 899px) and (min-height: 501px) {
    .rq-steps, .rq-msg { grid-row: auto; }
    .rq-msg { margin-top: 0; }
  }
  /* the step you are on: its number is a small sign of the red light; the two to come are quieter */
  .rq-steps .row[aria-current] .n { background: none; color: var(--light); -webkit-text-fill-color: currentColor; }
  .rq-steps .row:not([aria-current]) .k { color: var(--fg-2); }
  .rq-steps .row:not([aria-current]) .n { background: none; color: var(--muted); -webkit-text-fill-color: currentColor; }
</style>

---
// The booking page. The booking itself is the full-screen dialog (Book.astro), which opens straight away here; the
// page under it is what stays when it is closed: the three steps and their button, the table with its lamp standing
// in a case as the menu's drawings do (the line art, its lamp out until the table is booked: the thanks page lights
// it), and beside them the call-back card and the terms in short.
import Base from '../../../layouts/Base.astro';
import Logo from '../../../components/Logo.astro';
import PageTitle from '../../../components/PageTitle.astro';
import LineArt from '../../../components/LineArt.astro';
import { type Lang, ui, langPaths } from '../../../data/i18n';
import { site } from '../../../data/site';
import { bookingFine } from '../../../data/content';
import { tr } from '../../../data/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const f = t.form;
const ru = lang === 'ru';
import { show } from '../../../data/variants';
import { keepShort } from '../../../data/format';
---
<Base lang={lang} title={ru ? 'Бронь стола' : 'Book a table'} description={ru ? 'Забронируйте стол, карту клуба или праздник в HOTLAND.' : 'Book a table, a club card or a party at HOTLAND.'} closing={false}>
  <PageTitle
    crumbs={[{ href: `/${lang}/`, label: 'HOTLAND' }, { label: ru ? 'Бронь стола' : 'Book a table' }]}
    title={ru ? 'Бронь стола' : 'Book a table'}
    sub={ru ? 'Три вопроса <em>и&nbsp;звонок</em>' : 'Three questions <em>and one call</em>'}
    lead={tr(bookingFine, lang)}
  />

  <!-- The booking is the full-screen dialog (Book.astro), three short steps; arriving here opens it straight away,
       with this page's ?type=, ?date= and ?occasion=. Closed, this button opens it again. -->
  <section class="sec">
    <div class="wrap g12" style="align-items: start">
      <div class="stack bk-cta" style="grid-column: 1 / span 7">
        <h2 class="t-l" set:html={ru ? 'Бронь <em>в&nbsp;три шага</em>' : 'Book <em>in three steps</em>'} />
        <p class="body" set:html={keepShort(ru ? 'Что выбираете, сколько вас и как с вами связаться. Менеджер подтвердит бронь и назовёт депозит.' : 'What you’re booking, how many of you and how to reach you. Your manager confirms and names the deposit.', lang)} />
        <div class="btns">
          <button class="btn btn-crimson" type="button" data-book aria-haspopup="dialog">{ru ? 'Забронировать' : 'Book a table'}</button>
        </div>
        <!-- the table waiting, in its case: its lamp is out (lit only when the room is, after 04:00) -->
        <div class="bkp-case" aria-hidden="true"><LineArt name="lamp" class="bkp-lamp" /></div>
      </div>
      <aside class="stack" style="grid-column: 9 / span 4; gap: 56px">
        <div class="invite">
          <Logo height={13} sign="tight" />
          <!-- (the contact is settled on Luka's, the call back: data/variants.ts; the phone number's version stays here, hidden) -->
          {show('contact', 'luka') && (
            <div class="vx-part" data-v="contact:luka">
              <p class="t-s">{ru ? 'Удобнее по телефону или есть вопрос?' : 'Prefer to talk, or have a question?'}</p>
              <div class="btns invite-ask">
                <!-- (frames, as in «Как нас найти»: «Забронировать» stays the page's one main button) -->
                <button class="btn btn-line btn-sm" type="button" data-contact="callback">{ru ? 'Заказать звонок' : 'Request a call'}</button>
                <button class="btn btn-line btn-sm" type="button" data-contact="question">{ru ? 'Задать вопрос' : 'Ask a question'}</button>
              </div>
              <p class="t-s invite-or">{f.faster}</p>
            </div>
          )}
          {show('contact', 'gio') && (
            <div class="vx-part" data-v="contact:gio">
              <p class="t-s">{f.faster}</p>
              <a class="phone" href={site.phoneHref}>{site.phone}</a>
            </div>
          )}
          <div class="btns invite-msg">
            <a class="btn btn-line btn-sm" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
            <a class="btn btn-line btn-sm" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
          </div>
        </div>
        <div class="stack fine">
          <h3 class="t-m">{f.termsTitle}</h3>
          <div class="rows">{f.terms.map((x) => <div class="row"><span class="k" set:html={keepShort(x, lang)} /></div>)}</div>
          <a class="lnk" href={`/${lang}/terms/`}>{f.allTerms}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .bk-cta { max-width: 640px; }
  /* a computer: the three steps, their button and the table are short beside the card and the terms, so they stay
     in view, under the header, while the taller column passes (the left half of the screen is never left empty) */
  @media (min-width: 900px) and (min-height: 600px) { .bk-cta { position: sticky; top: calc(var(--hdr) + 32px); } }
  /* The table with its lamp, under the button, in a case of lacquer black, as the menu's drawings stand (menu.css):
     one hairline round it, and the front edge of the floor it stands on a fine line across the case a little below
     its foot. The case is as tall as the screen leaves under the steps, so the column that stays in view is always
     whole; on a phone it is a little wider than tall. Its light is the room's (--room, global.css: after 04:00), and
     with it the floor's edge catches the amber under the lamp; a booked table's is lit (the thanks page).
     (--q: the drawing's height, as a share of the case's; --fb: how far its box runs below its foot, 447 of 500) */
  .bkp-case {
    --q: .76; --fb: .1052;
    position: relative; width: 100%; height: clamp(240px, 100svh - 470px, 460px); margin-top: clamp(8px, 1.6vw, 24px);
    overflow: hidden; background: var(--lacquer); box-shadow: inset 0 0 0 1px var(--rule);
  }
  .bkp-case::after {
    content: ''; position: absolute; left: 1px; right: 1px; bottom: 12%; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, var(--rule), var(--rule-2) 34%, color-mix(in srgb, var(--amber-core) calc(var(--room) * 62%), var(--rule-2)) 50%, var(--rule-2) 66%, var(--rule));
  }
  .bkp-case :global(.bkp-lamp) {
    position: absolute; left: 50%; translate: -50% 0; width: auto; height: calc(var(--q) * 100%); aspect-ratio: 440 / 500;
    bottom: calc(19% - var(--q) * var(--fb) * 100%);
  }
  .bkp-case :global(.bkp-lamp .la-light) { opacity: var(--room); transition: opacity 1.2s ease; }
  @media (max-width: 899px) { .bkp-case { height: auto; aspect-ratio: 6 / 5; } }
  /* The card beside the steps, square-cut like every plate. Its buttons stand in one column of one width: the two
     requests one under the other, the two messengers side by side under them, each half that width. (Left to wrap
     by themselves, the two requests stacked at two different widths.) */
  .invite { justify-self: stretch; } /* (as wide as its column, whatever its words: the English ones left it narrower) */
  .invite .t-s { text-wrap: balance; }
  .invite .btns { display: grid; gap: 10px; width: min(100%, 264px); }
  .invite .invite-msg { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .invite .btn { padding-inline: 10px; }
  /* the terms in short are read, so they are the text face at its reading size (the shared rows set them a step
     smaller) */
  .fine .row .k { font-size: 16px; }
</style>

---
// The page after "No" on the 18+ door: the door from outside, closed. The wall's dark concrete (the door's own
// recipe, styles/gate.css, with its light turned down), the name on it in fine steel capitals with the line of red
// light (Name.astro), one title, one line, and a quiet way back to the question. No club content, no menu.
import Base from '../../layouts/Base.astro';
import Name from '../../components/Name.astro';
import { type Lang, ui, langPaths } from '../../data/i18n';
import { keepShort } from '../../data/format';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const ru = lang === 'ru';
---
<Base lang={lang} title={ru ? 'Доступ ограничен' : 'Access restricted'} bare noindex>
  <section class="bye">
    <div class="bye-in">
      <Name label class="bye-name" />
      <h1 class="bye-h">{ru ? 'Только 18+' : '18+ only'}</h1>
      <p class="bye-line" set:html={keepShort(ui[lang].gate.bye, lang)} />
      <a class="bye-back" href={`/${lang}/`}><span>{ru ? 'Вернуться' : 'Back'}</span></a>
    </div>
  </section>
</Base>

<style is:global>
  /* The wall: the door's concrete (gate.css, .gate-face: the stone's grain and clouds laid over a near-black, the
     corners falling away, the light from the upper left), with that light at half strength: the door is shut.
     Its last pixels on the right settle into the tone the window's edge has while no answer is given (--gate-end),
     so the wall runs to the edge where a scrollbar's room is kept. */
  .bye {
    /* the block stands a little above the middle: its centre at 42% of the screen's height */
    min-height: 100svh; display: grid; place-items: center; padding: var(--pad) var(--pad) calc(16svh + var(--pad));
    text-align: center; color: var(--fg);
    background-color: #08090a;
    background-image:
      linear-gradient(270deg, var(--gate-end, #080808) 0, rgba(8, 8, 8, 0) 56px),
      radial-gradient(130% 105% at 34% 30%, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, .7) 100%),
      url('/img/concrete/concrete.webp'), url('/img/concrete/mottle.webp'),
      radial-gradient(ellipse 58% 56% at 2% 2%, rgba(236, 238, 244, .18) 0%, rgba(236, 238, 244, .085) 36%, rgba(236, 238, 244, .025) 66%, rgba(236, 238, 244, 0) 100%),
      linear-gradient(115deg, #17181a 0%, #0c0d0e 52%, #070708 100%);
    background-size: auto, auto, 430px auto, 1500px auto, auto, auto;
    background-blend-mode: normal, normal, overlay, overlay, normal, normal;
  }
  .bye-in { display: grid; justify-items: center; }
  /* the name as the wall carries it: fine steel capitals, the light in the joint; its shadow falls down and right */
  .bye .bye-name { height: clamp(18px, 1.75vw, 26px); filter: drop-shadow(1px 2px 2px rgba(0, 0, 0, .8)); }
  /* (the light's points reach above and below the capitals: the title starts clear of the lower one) */
  .bye-h { margin-top: clamp(48px, 5vw, 72px); font: 450 clamp(32px, 3.4vw, 52px)/1.05 var(--display); letter-spacing: -.012em; font-variant-numeric: lining-nums; }
  .bye-line { max-width: 34ch; margin-top: clamp(10px, 1vw, 14px); font: 400 clamp(16px, 1.3vw, 19px)/1.6 var(--sans); color: #cfd0d3; text-wrap: balance; }
  /* the way back to the question: small wide capitals over a hairline, a finger's height to tap; under the pointer
     the hairline turns to the red light, as the site's links do */
  .bye-back {
    display: inline-flex; align-items: center; min-height: 44px; margin-top: clamp(14px, 1.6vw, 22px); padding: 0 14px;
    font: 500 12px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: #9a9ca2;
    transition: color .3s ease; -webkit-tap-highlight-color: transparent;
  }
  .bye-back span {
    padding: 8px 0 8px .14em; /* (the last letter's spacing is balanced on the left, so the word sits centred) */
    background: linear-gradient(var(--light), var(--light)) 0 100% / 0 1px no-repeat, linear-gradient(var(--rule-2), var(--rule-2)) 0 100% / 100% 1px no-repeat;
    transition: background-size .6s var(--ease-out);
  }
  .bye-back:hover, .bye-back:focus-visible { color: var(--fg); }
  .bye-back:hover span { background-size: 100% 1px, 100% 1px; }
  /* arriving (only when motion is welcome): the four rise into place, one after another */
  @media (prefers-reduced-motion: no-preference) {
    .bye-in > * { animation: bye-rise .9s var(--ease-out) backwards; }
    .bye-in > :nth-child(2) { animation-delay: .08s; }
    .bye-in > :nth-child(3) { animation-delay: .16s; }
    .bye-in > :nth-child(4) { animation-delay: .24s; }
  }
  @keyframes bye-rise { from { opacity: 0; translate: 0 14px; } }
</style>

---
// The Афиша: the special nights as posters set in type (PosterCard.astro), month by month, as a printed programme
// has them, then every night's own programme, the four acts by the hour beside a guest under the laser (the line
// art's "shoulder"). Styles: styles/posters.css.
import Base from '../../../layouts/Base.astro';
import PageTitle from '../../../components/PageTitle.astro';
import PosterCard from '../../../components/PosterCard.astro';
import LineArt from '../../../components/LineArt.astro';
import { type Lang, ui, tr, langPaths } from '../../../data/i18n';
import { events, eventsLead, night, type Event } from '../../../data/content';
import { keepShort } from '../../../data/format';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const ru = lang === 'ru';
// The nights by month, in date order: each month's name (in the Poster voice, as month names are on the Афиша) over
// its own row of posters. A month carries the date of its last night, so the site's script (scripts/site.ts, "Events
// that have passed") takes its name away with its posters once that night has been.
const months: { key: string; name: string; year: string; last: string; nights: Event[] }[] = [];
for (const e of [...events].sort((a, b) => a.date.localeCompare(b.date))) {
  const key = e.date.slice(0, 7);
  let m = months.find((x) => x.key === key);
  if (!m) {
    const [y, mo] = key.split('-').map(Number);
    m = { key, name: new Date(y, mo - 1, 1).toLocaleDateString(ru ? 'ru-RU' : 'en-GB', { month: 'long' }), year: String(y), last: e.date, nights: [] };
    months.push(m);
  }
  m.nights.push(e);
  m.last = e.date;
}
---
<Base lang={lang} title={ru ? 'Афиша' : 'Events'} description={ru ? 'Афиша HOTLAND: Courchevel в пятницу, Velvet в субботу, Ritual в воскресенье. А шоу-балет каждую ночь в 23:30 и 01:30.' : 'Events at HOTLAND: Courchevel on Friday, Velvet on Saturday, Ritual on Sunday. And the dance show every night at 23:30 and 01:30.'}>
  <PageTitle
    crumbs={[{ href: `/${lang}/`, label: 'HOTLAND' }, { label: t.nav.program }]}
    title={ru ? 'Афиша' : 'Events'}
    sub={ru ? 'Один вечер, <em>одна тема</em>' : 'One night, <em>one theme</em>'}
    lead={tr(eventsLead, lang)}
  >
    <a class="btn btn-crimson" href={`/${lang}/booking/`}>{t.bookTable}</a>
  </PageTitle>

  <!-- 01 Event nights: month by month, the month's name over its row of posters -->
  <section class="sec afisha">
    <div data-events>
      {months.map((m) => (
        <div class="afisha-month" data-event-date={m.last}>
          <div class="wrap"><h2 class="afisha-mname" style={`--n:${[...m.name].length}`}>{m.name}<span>{m.year}</span></h2></div>
          <div class="posters" data-lenis-prevent-horizontal>
            {m.nights.map((e) => <PosterCard e={e} lang={lang} />)}
          </div>
        </div>
      ))}
    </div>
    <div class="wrap">
      <p class="body" data-events-empty hidden>{ru ? 'Новые особые вечера скоро. А шоу-балет каждую ночь в 23:30 и 01:30.' : 'New special nights are coming. The dance show is on every night at 23:30 and 01:30.'}</p>
    </div>
  </section>

  <!-- 02 Every night: the four acts by the hour (the Dial), beside the guest under the laser, hung as every drawing
       on the site hangs: on lacquer inside one hairline (posters.css). The laser follows the hour: off after four,
       when the room's amber catches him instead (lineart.css). -->
  <section class="sec nightly" aria-labelledby="nightly-h">
    <div class="wrap">
      <div class="bighead bh-line">
        <h2 class="t-l" id="nightly-h">{tr(night.title, lang)}</h2>
        <div class="bighead-side"><p class="body" set:html={keepShort(tr(night.lead, lang), lang)} /></div>
      </div>
      <div class="nightly-in">
        <LineArt name="shoulder" class="nightly-art" />
        <ol class="rows nightly-acts">
          {night.acts.map((a) => (
            <li class="row nightly-act">
              <span class="nightly-time">{a.time}</span>
              <div class="nightly-words">
                <h3 class="nightly-t">{tr(a.title, lang)}</h3>
                <p class="nightly-x" set:html={keepShort(tr(a.text, lang), lang)} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>

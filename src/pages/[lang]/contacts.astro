---
// Contacts now live on the club page (/about/#contacts). This old address sends visitors there.
import { type Lang, langPaths } from '../../data/i18n';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const to = `/${lang}/about/#contacts`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>HOTLAND</title>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body style="background:#000;color:#f2f0ec;font-family:sans-serif"><a href={to} style="color:inherit">{lang === 'ru' ? 'Контакты здесь' : 'Contacts are here'}</a></body>
</html>

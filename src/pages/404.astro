---
import Base from '../layouts/Base.astro';
import Icon3d from '../components/Icon3d.astro';
---
<Base lang="ru" title="404" noindex>
  <section class="thanks">
    <div class="wrap stack center">
      <Icon3d name="keyhole" size={240} class="moment-ic" eager />
      <h1 class="t-xl">Эта дверь <em>закрыта</em></h1>
      <p class="lead">Такой страницы нет. Зато остальные открыты. <br />This door is locked, but the others are open.</p>
      {/* the page serves both languages: each button says its words in both, one over the other */}
      <div class="btns lost-btns" style="justify-content: center">
        <a class="btn btn-crimson" href="/ru/booking/"><span>Забронировать стол</span><span lang="en">Book a table</span></a>
        <a class="btn btn-line" href="/ru/program/"><span>Афиша</span><span lang="en">Events</span></a>
        <a class="btn btn-line" href="/ru/"><span>Главная</span><span lang="en">Home</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost-btns .btn { flex-direction: column; gap: 7px; height: 64px; }
  .lost-btns .btn span:last-child { font-size: 10.5px; letter-spacing: .16em; opacity: .7; }
</style>

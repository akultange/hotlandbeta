---
// An event night as a printed poster (styles in styles/posters.css). Since 2026-11-21 («Между») the poster is set in
// type, the way a club's flyer is: no photograph. The date is the picture: the day in the Poster voice, huge, at the
// top left, the month and the weekday small beside it; one beam of light crosses the poster (red on a night of the
// stage, amber on a night of the room: content.ts `light`), and the night's name stands at its foot, in the Poster
// voice too. Under the poster, in the Label voice: the weekday and doors time, and the entry; then one short line
// about the night. The whole card books that night: the booking page opens with "Особый вечер" and the night's date
// already chosen. With a mouse, a small smoked plate reading "Бронь" follows beside the pointer over the poster. On a
// phone the row of posters is a row to swipe (its hold while the page scrolled on, sliding from poster to poster, is
// switched off: holdRow).
import { type Lang, tr, ui } from '../data/i18n';
import { type Event } from '../data/content';
import { site, price } from '../data/site';
import { fullDate, keepShort } from '../data/format';
import '../styles/posters.css';
/** here: this is the night whose page you are on (its card says so instead of the price).
 *  past: a night that has been: its light is off, «Прошёл» instead of the price, the year in the line under it, and
 *  it leads to the gallery instead of booking. */
interface Props { e: Omit<Event, 'loop'> & { loop?: string }; lang: Lang; here?: boolean; past?: boolean }
const { e, lang, here = false, past = false } = Astro.props;
const t = ui[lang];
const ru = lang === 'ru';
const title = tr(e.title, lang);
const [y, m, d] = e.date.split('-').map(Number);
const date = new Date(y, m - 1, d);
const loc = ru ? 'ru-RU' : 'en-GB';

/** How wide each capital runs in the Poster voice (Roboto Flex 1000 at width 151, tracked -.01em, as posters.css
 *  sets it), in em: measured in Chrome with the site's own font files. The night's name is set as large as its
 *  longest word allows, so "Courchevel" fits the poster as "Velvet" does (an unknown sign counts as a wide one). */
const EM: Record<string, number> = {
  A: .977, B: .874, C: 1.012, D: .917, E: .857, F: .766, G: 1.001, H: .957, I: .419, J: .802, K: 1.016, L: .731, M: 1.281,
  N: .926, O: 1.042, P: .931, Q: 1.042, R: .968, S: .911, T: .864, U: 1.005, V: .986, W: 1.432, X: .917, Y: .964, Z: .918,
  А: .977, Б: .882, В: .874, Г: .758, Д: .954, Е: .857, Ё: .857, Ж: 1.441, З: .894, И: .971, Й: .971, К: .996, Л: .925,
  М: 1.281, Н: .957, О: 1.042, П: .947, Р: .931, С: 1.012, Т: .855, У: .933, Ф: 1.227, Х: .882, Ц: .981, Ч: .927,
  Ш: 1.338, Щ: 1.372, Ъ: .953, Ы: 1.286, Ь: .892, Э: .99, Ю: 1.418, Я: .961, '-': .505, '&': .909, '’': .283, "'": .244, '.': .342,
};
const wordEm = (w: string) => [...w.toUpperCase()].reduce((s, c) => s + (/\d/.test(c) ? .918 : EM[c] ?? 1.05), 0);
const len = Math.max(...title.split(/\s+/).map(wordEm), 3).toFixed(2);

/** One short line for under the poster: the first sentence of the night's text, or, when that sentence runs
 *  long, the words before its colon or dash (the whole text is on the night's page). A past night's poster is
 *  narrower, so its sentence is cut sooner: the line always ends whole within its two lines, in both languages. */
const shortLine = (s: string, max = 60) => {
  const first = s.match(/^.+?[.!?…](?=\s|$)/)?.[0] ?? s;
  if (first.length <= max) return first;
  const head = first.split(/:\s|\s[—–]\s/)[0].trim();
  return head.length >= 12 && head.length < first.length ? `${head.replace(/[,;]$/, '')}.` : first;
};

// the poster's corner: the month and the weekday, short ("дек", "сб"; "Dec", "Sat"), set in capitals by the CSS
const short = (o: Intl.DateTimeFormatOptions) => date.toLocaleDateString(loc, o).replace(/\.$/, '');
const mon = short({ month: 'short' });
const wd = short({ weekday: 'short' });
const day = String(d).padStart(2, '0');
const doors = site.hours[(date.getDay() + 6) % 7].open; // site.hours starts on Monday
const when = past
  ? date.toLocaleDateString(loc, { day: 'numeric', month: 'long', year: 'numeric' }).replace(/\s*г\.$/, '')
  : `${wd} · ${doors}`;
const entry = price(e.entry, lang);
const lineId = `poster-${e.slug}-line`;
// in Russian a short word ("и", "в") never ends a line: it goes down with the word after it
const line = keepShort(shortLine(tr(e.text, lang), past ? 50 : 60).replace(/&/g, '&amp;').replace(/</g, '&lt;'), lang);
// The beam: which light (the night's own, red unless content.ts says amber), and how it crosses this poster. Each
// date tilts it its own way and at its own height, so a row of posters never repeats one picture.
const tone = e.light === 'amber' ? 'amber' : 'red';
const TILT = [-6, 5, -4, 7, -7, 4, -5];
const LEVEL = [58, 54, 61];
const beam = `--tilt:${TILT[d % 7]}deg;--beam-y:${LEVEL[d % 3]}%;--len:${len}`;
---
<article class:list={['poster', `poster-${tone}`, { 'is-here': here, 'is-past': past }]} data-event-date={past ? undefined : e.date}>
  <a class="poster-link" href={past ? `/${lang}/gallery/` : `/${lang}/booking/?type=ticket&date=${e.date}`} aria-current={here ? 'page' : undefined} aria-label={past ? `${ru ? 'Фото вечера' : 'Photos of the night'}: ${title}, ${fullDate(e.date, lang)}` : `${ru ? 'Забронировать вечер' : 'Book the night'}: ${title}, ${fullDate(e.date, lang)}, ${doors}. ${t.entry} ${entry}`} aria-describedby={lineId}>
    <span class="poster-frame" style={beam} aria-hidden="true">
      <span class="poster-beam"><i></i></span>
      <span class="poster-top">
        <span class="poster-day">{day}</span>
        <span class="poster-mw"><span>{mon}</span><span>{wd}</span></span>
      </span>
      <span class="poster-name">{title}</span>
    </span>
    <span class="poster-row" aria-hidden="true">
      <span class="poster-when">{when}</span>
      {past ? <span class="poster-past">{ru ? 'Прошёл' : 'Past'}</span> : here ? <span class="poster-here">{ru ? 'Вы здесь' : 'You are here'}</span> : <span class="poster-price">{t.entry} {entry}</span>}
    </span>
    <span class="poster-line" id={lineId} set:html={line} />
  </a>
</article>

<script>
  import { gsap } from 'gsap';

  // With a mouse: over a poster a small plate beside the pointer reads "Бронь" (the card books that night). It
  // glides after the pointer; for reduced motion it simply sits by it. When a scroll moves the poster from under a
  // still pointer the plate goes, and the next move over a poster brings it back.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !document.querySelector('.poster-cursor')) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const disc = document.createElement('div');
    disc.className = 'poster-cursor';
    disc.setAttribute('aria-hidden', 'true');
    disc.innerHTML = `<span>${document.documentElement.lang === 'ru' ? 'Бронь' : 'Book'}</span>`;
    document.body.append(disc);
    const xTo = gsap.quickTo(disc, 'x', { duration: still ? 0 : 0.42, ease: 'power3' });
    const yTo = gsap.quickTo(disc, 'y', { duration: still ? 0 : 0.42, ease: 'power3' });
    const show = (on: boolean) => {
      disc.classList.toggle('on', on);
    };
    let px = -1, py = -1, rq = 0;
    const appear = (e: PointerEvent) => {
      px = e.clientX;
      py = e.clientY;
      gsap.set(disc, { x: e.clientX, y: e.clientY });
      xTo(e.clientX);
      yTo(e.clientY);
      show(true);
    };
    // (not on a night that has been: it leads to the gallery, not to a booking)
    document.querySelectorAll<HTMLElement>('.poster:not(.is-past) .poster-frame').forEach((frame) => {
      frame.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') appear(e); });
      frame.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        if (!disc.classList.contains('on')) { appear(e); return; } // back after a scroll
        px = e.clientX;
        py = e.clientY;
        xTo(e.clientX);
        yTo(e.clientY);
      });
      frame.addEventListener('pointerleave', () => show(false));
    });
    // the page moved under a still pointer (smooth scrolling): the plate stays while a poster is still under the
    // pointer and goes the moment none is, rather than float over the wrong thing
    addEventListener('scroll', () => {
      if (rq || !disc.classList.contains('on')) return;
      rq = requestAnimationFrame(() => {
        rq = 0;
        if (!document.elementFromPoint(px, py)?.closest('.poster:not(.is-past) .poster-frame')) show(false);
      });
    }, { passive: true });
  }

  // Phones, home page: the weekend's posters could hold still in the middle of the screen while the page scrolls
  // on, sliding from one night to the next and resting on each (holdRow, below). Switched off on 2026-11-13: the
  // client asked for no sideways movement driven by the page's scroll in the Афиша, so the row is an ordinary row
  // to swipe, as for reduced motion. The code stays, in case they want it back: call holdRow on [data-prow].
  // const prow = document.querySelector<HTMLElement>('[data-prow]');
  // if (prow) holdRow(prow);
  function holdRow(track: HTMLElement) {
    const pin = track.querySelector<HTMLElement>('.prow-pin')!;
    const row = track.querySelector<HTMLElement>('.posters')!;
    const phone = matchMedia('(max-width: 699px) and (orientation: portrait)'); // (sideways: an ordinary swipe row)
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const REST = 0.22; // of each poster's stretch of scrolling, the part at either end where the row rests
    const ease = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
    let xs: number[] = [];
    let run = 1, on = false, raf = 0, width = 0;
    const progress = () => Math.min(1, Math.max(0, -track.getBoundingClientRect().top / run));
    // where the row stands for each poster (the last one ends at the right edge), and how far the page scrolls
    const measure = () => {
      const cards = Array.from(row.querySelectorAll<HTMLElement>('.poster')).filter((c) => !c.hidden);
      const max = row.scrollWidth - row.clientWidth;
      const pad = parseFloat(getComputedStyle(row).paddingLeft) || 0;
      xs = cards.map((c) => Math.min(max, Math.max(0, c.offsetLeft - pad)));
      run = Math.max(1, (xs.length - 1) * Math.round(pin.offsetHeight * 0.6));
      track.style.height = xs.length > 1 ? `${pin.offsetHeight + run}px` : '';
      // the room the held screen has besides the row (styles/posters.css keeps the row close under its heading
      // and takes the rest back after the hold); the row's own margins are its focus ring's room, not the row
      const rs = getComputedStyle(row);
      const rowH = row.offsetHeight + (parseFloat(rs.marginTop) || 0) + (parseFloat(rs.marginBottom) || 0);
      track.style.setProperty('--pin-free', `${Math.max(0, pin.clientHeight - rowH)}px`);
    };
    const place = () => {
      raf = 0;
      if (!on || xs.length < 2) return;
      const s = progress() * (xs.length - 1);
      const i = Math.min(xs.length - 2, Math.floor(s));
      const f = ease(Math.min(1, Math.max(0, (s - i - REST) / (1 - 2 * REST))));
      row.scrollLeft = xs[i] + (xs[i + 1] - xs[i]) * f;
    };
    const set = () => {
      const want = phone.matches && !still.matches && !row.hidden;
      if (want !== on) {
        on = want;
        track.classList.toggle('on', on);
        if (!on) { track.style.height = ''; row.scrollLeft = 0; return; }
      }
      if (on) { width = innerWidth; measure(); place(); }
    };
    addEventListener('scroll', () => { if (on && !raf) raf = requestAnimationFrame(place); }, { passive: true });
    // the phone's toolbar growing and shrinking changes the height, not the width: only a new width re-measures
    addEventListener('resize', () => { if (!on || innerWidth !== width) set(); });
    phone.addEventListener('change', set);
    addEventListener('load', set);
    set();
    let sx = 0, sy = 0;
    row.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    row.addEventListener('touchend', (e) => {
      if (!on || xs.length < 2) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - sx;
      const dy = t.clientY - sy;
      if (Math.abs(dx) < 40 || Math.abs(dx) < 1.4 * Math.abs(dy)) return;
      const n = xs.length - 1;
      const at = Math.round(progress() * n);
      const to = Math.min(n, Math.max(0, at + (dx < 0 ? 1 : -1)));
      if (to === at) return;
      scrollTo({ top: Math.round(scrollY + track.getBoundingClientRect().top + (to / n) * run), behavior: 'smooth' });
    }, { passive: true });
  }
</script>

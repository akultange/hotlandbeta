---
// Phone action dock: a floating glass bar with call, WhatsApp and directions, and "Book" as a crimson pill
// on the right, under the thumb. "Call" asks for a call back (Ask.astro): the club's number is never shown. "Book"
// opens the booking where you are (Book.astro), on the booking page too. Hidden from 900px up.
import { type Lang, ui } from '../data/i18n';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
import { show } from '../data/variants';
---
<nav class="mbar" aria-label={lang === 'ru' ? 'Быстрые действия' : 'Quick actions'}>
  {show('contact', 'luka') && (
  <button class="mbar-act" type="button" data-contact="callback" data-v="contact:luka" aria-label={lang === 'ru' ? 'Заказать звонок' : 'Request a call'}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.4 3.6 9.9 7c.3.7.1 1.5-.5 2l-1.3 1.1a11.6 11.6 0 0 0 5.8 5.8l1.1-1.3c.5-.6 1.3-.8 2-.5l3.4 1.5c.7.3 1.1 1.1.9 1.9l-.5 2.1c-.2.8-.9 1.4-1.8 1.4C10.6 21 3 13.4 3 4.9c0-.9.6-1.6 1.4-1.8l2.1-.5c.8-.2 1.6.2 1.9 1z" /></svg>
    <span>{lang === 'ru' ? 'Звонок' : t.call}</span>
  </button>
  )}
  {show('contact', 'gio') && (
  <a class="mbar-act" data-v="contact:gio" href={site.phoneHref}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.4 3.6 9.9 7c.3.7.1 1.5-.5 2l-1.3 1.1a11.6 11.6 0 0 0 5.8 5.8l1.1-1.3c.5-.6 1.3-.8 2-.5l3.4 1.5c.7.3 1.1 1.1.9 1.9l-.5 2.1c-.2.8-.9 1.4-1.8 1.4C10.6 21 3 13.4 3 4.9c0-.9.6-1.6 1.4-1.8l2.1-.5c.8-.2 1.6.2 1.9 1z" /></svg>
    <span>{lang === 'ru' ? 'Звонок' : t.call}</span>
  </a>
  )}
  <a class="mbar-act" href={site.whatsapp} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5 4.8 16A8.6 8.6 0 1 1 8 19.3z" /><path d="M9.3 8.3c.3-.4.9-.4 1.2 0l.8 1.5c.2.3.1.7-.1 1l-.5.5c.6 1.2 1.5 2.1 2.7 2.7l.5-.5c.3-.2.7-.3 1-.1l1.5.8c.4.3.4.9 0 1.2-.6.6-1.5.9-2.4.7-2.4-.6-4.3-2.5-4.9-4.9-.2-.9.1-1.8.7-2.4z" /></svg>
    <span>{t.whatsapp}</span>
  </a>
  <a class="mbar-act" href={site.mapUrl} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.2s-6.8-5.9-6.8-11.4a6.8 6.8 0 0 1 13.6 0c0 5.5-6.8 11.4-6.8 11.4z" /><circle cx="12" cy="9.8" r="2.5" /></svg>
    <span>{t.directions}</span>
  </a>
  <a class="btn btn-crimson mbar-book" href={`/${lang}/booking/`}>{t.book}</a>
</nav>

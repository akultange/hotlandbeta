---
// The home page's first screen: the door («Между», 2026-11-21; styles in styles/hero.css). The same two leaves of
// formwork concrete as the 18+ door (AgeGate.astro), standing open: between them, the room behind the door, the
// club's own film in black and white and dark, red lasers sweeping through the haze, and the room's amber spilling
// through the gap onto the floor. The club's logo is fixed across the leaves, HOT on the left and LAND on the right,
// the gap's lit edge running along the L as the logo's needle does; under the name the club's hours are painted on
// the leaves, 22:00 and 06:00, in the Poster's capitals (running down the leaves on a phone). On the floor, the line
// that says what the place is, and the two buttons.
// The door keeps the club's hours (html[data-hour], data/hero.ts): open, the lasers in the gap; after 04:00 the
// lasers rest and the gap glows amber; after 06:00 the door is shut, its seam the only light and the logo whole
// across it, and the floor says when the club opens again, with a table for tonight.
// The 18+ door stands on the same skeleton (styles/first-screen.css), so "Yes" opens it straight into this one.
// (The earlier takes, v1 the film with HOTLAND in steel, v2 the film inside the letters and v3 the frosted glass,
// are in the history up to 2026-11-21: «Между» retired their chrome, frost and burgundy haze.)
import { type Lang, ui } from '../data/i18n';
import { HERO_PHONE } from '../data/hero';
import { nameHalves } from '../data/wordmark';
import { signGlow as art } from '../data/art';
import { site } from '../data/site';
import '../styles/first-screen.css';
import '../styles/hero.css';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const ru = lang === 'ru';
const p = (s: string) => `/${lang}/${s}/`;

// the name as the door carries it (data/wordmark.ts, nameHalves): the same lockup as on the 18+ door
const nm = nameHalves();
const SIGN_BOX = art.box.join(' ');
// the club's hours, as every night has them (the header's menu sheet says them the same way)
const { open, close } = site.hours[0];
const film = {
  label: ru ? 'Видео: ночь в HOTLAND, артистка на круглой сцене, лучи, пилон' : 'Video: a night at HOTLAND, an artist on the round stage, beams, the pole',
  pause: ru ? 'Пауза' : 'Pause',
  play: ru ? 'Смотреть' : 'Play',
};
// (2026-11-20: the club asked for the motto, «Только между нами», to go from the first screen: the name, one line that
// says what the place is, and the two buttons. The motto stays in the page's title and on the footer's card.)
const lead = ru ? 'Премиальный мужской клуб в Москве' : 'A premium gentlemen’s club in Moscow';
// While the club is closed: when it opens again. Written here for tonight at the usual hour; the line's own script
// (below) sets the day the club's hours give, read before the first paint (data/hero.ts).
const opens = (when: string, at: string) => t.door.opens.replace('{when}', when).replace('{at}', at);
const when = { today: t.door.today, tomorrow: t.door.tomorrow, days: t.door.days, opens: t.door.opens };
const nextLine = `(function (s) { var h = window.__hlHour; if (!h || !h.next) return; var w = JSON.parse(s.dataset.when), n = h.next; var d = n.inDays === 0 ? w.today : n.inDays === 1 ? w.tomorrow : w.days[n.day]; s.querySelector('[data-opens]').textContent = w.opens.replace('{when}', d).replace('{at}', n.at); s.closest('.hero').classList.toggle('is-later', n.inDays > 0); })(document.currentScript.previousElementSibling);`;

// The lasers: one source above the gap, a fan of beams, each sweeping slowly to and fro on its own beat (hero.css).
// [angle from the vertical, sweep, seconds, phase, brightness]
const beams: [number, number, number, number, number][] = [
  [-38, 6, 13, -2, .55], [-29, 8, 9.5, -7, .8], [-21, 5, 12, -4, .65], [-14, 7, 8, -1, 1], [-8, 6, 14, -9, .7], [-3, 4, 10.5, -5, .9],
  [3, 5, 11, -3, .85], [9, 7, 9, -6, .75], [15, 6, 12.5, -8, 1], [22, 8, 10, -2, .6], [30, 6, 13.5, -10, .8], [39, 5, 11.5, -4, .5],
];
// The film's poster: the upright cut (and its poster) is for phones held upright; a phone turned sideways gets the
// wide one. The poster shows at once (preloaded in the page's head, HeroPreload.astro: it's what the page is first
// judged by), and only the one this screen needs: the tiny script after the film picks it, so a phone never fetches
// the wide one. The film itself is fetched only once the page has loaded and the 18+ question is answered (the script
// below), so its megabytes never hold up the first screen, and only the one cut the screen needs.
const starter = `(function (v) { v.poster = matchMedia('${HERO_PHONE}').matches ? v.dataset.posterPhone : v.dataset.poster; })(document.currentScript.previousElementSibling);`;
---
<section class="hero" style={`--wl:${nm.land.width};--ngu:${nm.gap};--nsu:${nm.axis}`}>
  <h1 class="sr-only">{ru ? 'HOTLAND, премиальный мужской клуб в Москве' : 'HOTLAND, a premium gentlemen’s club in Moscow'}</h1>
  <p class="sr-only">{t.door.hours.replace('{open}', open).replace('{close}', close)}</p>
  <div class="hv hv-door">
    {/* the room behind the door, seen through the gap: the film, the haze, the lasers, and after 04:00 its amber */}
    <div class="dr-room">
      <div class="dr-film">
        <video muted loop playsinline preload="none" data-poster="/video/hero-d.webp" data-poster-phone="/video/hero-m.webp" data-src="/video/hero-d.mp4" data-src-phone="/video/hero-m.mp4" aria-label={film.label}></video>
        <script is:inline set:html={starter} />
      </div>
      <div class="dr-haze" aria-hidden="true"></div>
      <div class="dr-lasers" aria-hidden="true">
        {beams.map(([a, s, d, o, k]) => <i style={`--a:${a}deg;--s:${s}deg;--t:${d}s;--o:${o}s;--k:${k}`}></i>)}
      </div>
      <div class="dr-lamp" aria-hidden="true"></div>
    </div>
    {/* the floor at the door's foot: the room's light spilling through the gap onto it; when the door is shut, the
        seam's red under it */}
    <div class="dr-floor" aria-hidden="true"><i class="dr-spill"></i><i class="dr-leak"></i></div>
    {/* the two leaves, each with its lit edge, its half of the name and its half of the hours */}
    <div class="dr-leaf door-leaf door-leaf-l" aria-hidden="true">
      <i class="door-edge door-edge-l"></i>
      <svg class="wall-half dr-half" viewBox={nm.box(nm.hot.width)} focusable="false">{nm.hot.paths.map((d) => <path d={d} />)}</svg>
      <span class="dr-hr">{open}</span>
    </div>
    <div class="dr-leaf door-leaf door-leaf-r" aria-hidden="true">
      <i class="door-edge door-edge-r"></i>
      <svg class="wall-half dr-half" viewBox={nm.box(nm.land.width)} focusable="false">{nm.land.paths.map((d) => <path d={d} />)}</svg>
      <span class="dr-hr">{close}</span>
    </div>
    {/* the door shut: the seam between the leaves, and where it crosses the L the logo's own sign (as on the 18+ door) */}
    <i class="dr-seam" aria-hidden="true"></i>
    <div class="dr-sign" aria-hidden="true">
      <svg viewBox={SIGN_BOX} focusable="false" set:html={art.aura + art.sign + art.core} />
    </div>
    {/* the wall over the door, where the header stands: the page's own ground, the header's line its lintel */}
    <div class="dr-lintel" aria-hidden="true"></div>
    <div class="hv-copy dr-copy">
      <p class="lead hv-lead">{lead}</p>
      <p class="dr-closed" data-when={JSON.stringify(when)}><span>{t.door.closed}</span> <span data-opens>{opens(t.door.today, open)}</span></p>
      <script is:inline set:html={nextLine} />
      <div class="hv-act">
        <a class="btn btn-crimson" href={p('booking')}><span class="dr-book">{t.bookTable}</span><span class="dr-book-tonight">{t.door.book}</span></a>
        <a class="btn btn-line" href={p('program')}>{t.nav.program}</a>
      </div>
    </div>
    <button class="vid-toggle" type="button" data-video-toggle data-pause={film.pause} data-play={film.play}><i aria-hidden="true"></i><span>{film.pause}</span></button>
  </div>
</section>

<script>
  // The door's film, its pause switch, the closed door's line through the night, and the door's depth as the page
  // moves on.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { clubHour } from '../data/hero';
  import { site } from '../data/site';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('.hero');
  const door = hero?.querySelector<HTMLElement>('.hv-door');
  const video = door?.querySelector('video') ?? null;
  const btn = door?.querySelector<HTMLButtonElement>('[data-video-toggle]') ?? null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- The film: it plays only while the door stands open and on screen. A visitor can pause it (WCAG
     2.2.2); with reduced motion it stays still until they press play. ---------- */
  let inView = true;
  // An iPhone in Low Power Mode starts no film by itself, muted or not, and a page can't ask whether that mode is on:
  // play() is refused. Then the visitor's next tap anywhere (the 18+ answer, the menu, a link) starts the film, not
  // only the «Смотреть» switch.
  let refused = false;
  // Nothing plays behind the 18+ question (it covers the whole screen): the film starts at the answer.
  const gateEl = document.getElementById('gate');
  const answered = () => !gateEl || root.classList.contains('age-ok') || gateEl.classList.contains('out');
  // The door shut (the club is closed, and the visitor has not asked for less motion: then the door always stands
  // open, global.css): nothing to see through it, so the film is neither fetched nor played.
  const shut = () => !reduce && root.dataset.hour === 'closed';
  const wants = (v: HTMLVideoElement) => answered() && inView && !shut() && (v.dataset.user === 'play' || (!reduce && v.dataset.user !== 'pause'));
  // after every click handler of the answer has run (the 18+ door's own adds .out)
  document.querySelector('[data-gate-yes]')?.addEventListener('click', () => setTimeout(run, 0));
  // The film is fetched only once the page has loaded (its poster stands in until then), and only the cut this screen
  // needs: the upright one on a phone held upright, the wide one anywhere else.
  const phoneCut = matchMedia('(max-width: 899px) and (orientation: portrait)');
  let loaded = document.readyState === 'complete';
  if (!loaded) addEventListener('load', () => { loaded = true; setTimeout(run, 0); setTimeout(warm, 300); }, { once: true });
  else setTimeout(warm, 300);
  // While the 18+ door stands shut the film is made ready behind it (fetched, not played), so that it is already
  // moving when the door opens. Not on a metered or slow line, where the answer fetches it as before.
  function warm() {
    if (answered() || reduce || shut() || !video) return;
    const net = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    if (net && (net.saveData || /2g|3g/.test(net.effectiveType || ''))) return;
    if (ready(video)) { video.preload = 'auto'; video.load(); }
  }
  function ready(v: HTMLVideoElement) {
    if (v.getAttribute('src')) return true;
    if (!loaded) return false;
    v.src = (phoneCut.matches && v.dataset.srcPhone) || v.dataset.src || '';
    return true;
  }
  function run() {
    if (!video) return;
    if (wants(video)) {
      if (video.paused) {
        if (!ready(video)) return;
        video.preload = 'auto';
        video.play()
          .then(() => { refused = false; })
          .catch((err: DOMException) => { if (err?.name === 'NotAllowedError') refused = true; });
      }
    } else if (!video.paused) video.pause();
  }
  addEventListener('touchend', () => { if (refused) run(); }, { passive: true });
  addEventListener('click', () => { if (refused) run(); });
  if (video && btn) {
    const label = btn.querySelector('span');
    const sync = () => {
      btn.classList.toggle('paused', video.paused);
      if (label) label.textContent = video.paused ? btn.dataset.play! : btn.dataset.pause!;
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    btn.addEventListener('click', () => {
      video.dataset.user = video.paused ? 'play' : 'pause';
      run();
    });
    sync();
  }
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      run();
    }).observe(hero);
  }
  run();

  /* ---------- Through the night: the club's hour changes while the page is open (scripts/site.ts tells it) ----------
     At 06:00 the door shuts (hero.css moves the leaves) and its line says when the club opens; at the opening it
     stands open again and the film comes back. */
  const closed = hero?.querySelector<HTMLElement>('[data-when]');
  const line = closed?.querySelector<HTMLElement>('[data-opens]');
  addEventListener('hotland:hour', () => {
    const h = clubHour(Date.now(), site.hours);
    if (closed && line && h.next) {
      const w = JSON.parse(closed.dataset.when!) as { today: string; tomorrow: string; days: string[]; opens: string };
      const n = h.next;
      line.textContent = w.opens.replace('{when}', n.inDays === 0 ? w.today : n.inDays === 1 ? w.tomorrow : w.days[n.day]).replace('{at}', n.at);
      hero?.classList.toggle('is-later', n.inDays > 0);
    }
    run();
  });

  /* ---------- As the page moves on (with motion only): the leaves part a little further, as if you were walking
     in, and the room dims behind them. Scrubbed with the scroll, from the hero's top to its foot. ---------- */
  if (root.classList.contains('motion') && door) {
    const leaves = door.querySelectorAll<HTMLElement>('.dr-leaf');
    const room = door.querySelector<HTMLElement>('.dr-room');
    const away = () => ({ trigger: door, start: 'top top', end: 'bottom top', scrub: true });
    gsap.fromTo(leaves[0], { x: 0 }, { x: () => -innerWidth * 0.08, ease: 'none', scrollTrigger: away() });
    gsap.fromTo(leaves[1], { x: 0 }, { x: () => innerWidth * 0.08, ease: 'none', scrollTrigger: away() });
    if (room) gsap.fromTo(room, { '--dim': 0 }, { '--dim': 0.6, ease: 'none', scrollTrigger: away() });
  }
</script>

---
// The 18+ question, as the club's door («Между», 2026-11-21): two leaves of formwork concrete, shut, the tie holes in
// their rows, and between them the red seam, the only light. The club's logo is fixed across the leaves, HOT on the
// left and LAND on the right, and where the seam crosses it at the L it burns as the logo's own sign: its needle of
// light, its aura, its white-hot core and the L's foot lit as its spur (data/art.ts), the letters beside it catching
// the light. Under the door the seam's light spills onto the floor, and on the floor stand the question and its two
// buttons. It is the first thing on every page and stays while the page loads. "Yes": the light runs the length of
// the seam, and the leaves open.
//
// The door stands on the same skeleton as the home page's door (styles/first-screen.css): the same leaves, the same
// floor, the same name. What the leaves do on "Yes" depends on what stands behind them:
//   - the home page's door, standing open (the club's hours: open or late): the leaves open exactly to where the home
//     page's own leaves stand, their light comes to rest on its lit edges, and the name is carried onto its name;
//     then the question's door gives way to the home page's, which is the same door to the pixel;
//   - the home page's door, shut (the club is closed): the leaves stay shut; the question goes and the door gives
//     way to the home page's, shut too, which says when the club opens;
//   - any other page (or the home page opened part-way down): the leaves part and leave the screen, their light and
//     the name with them.
// The page's own pieces then come in behind it (the header's plates, the phone's dock: global.css, "The door opens";
// the home page's: hero.css, Entrances). Styles: styles/gate.css.
//
// The club's hour (html[data-hour], data/hero.ts) is set here, before anything is drawn, for the whole page: this is
// the first thing in every page that has the door.
import { type Lang, ui, altPath } from '../data/i18n';
import { nameHalves } from '../data/wordmark';
import { signGlow as art } from '../data/art';
import { hourScript } from '../data/hero';
import '../styles/first-screen.css';
import '../styles/gate.css';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const path = Astro.url.pathname;
const nm = nameHalves();
// the sign's picture: the club's own file of the sign alone (127.8 by 596.58 units, the needle at x 58.85)
const SIGN_BOX = art.box.join(' ');
// a half's letters as one shape, for the light the letters catch from the sign: it shows only where there is a letter
// (a mask, gate.css .gate-heat)
const shape = (h: { paths: string[]; width: number }) =>
  `url("data:image/svg+xml,${`<svg xmlns='http://www.w3.org/2000/svg' viewBox='${nm.box(h.width)}'><path d='${h.paths.join(' ')}'/></svg>`.replace(/</g, '%3C').replace(/>/g, '%3E').replace(/#/g, '%23')}")`;
---
<script is:inline set:html={hourScript} />
<div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" aria-describedby="gate-text" tabindex="-1" data-lenis-prevent
  style={`--wl:${nm.land.width};--ngu:${nm.gap};--nsu:${nm.axis}`}>
  <div class="gate-in">
    {/* the floor the door stands on (the page's own ground), and the seam's light spilling onto it under the door */}
    <div class="gate-floor" aria-hidden="true"><i class="gate-leak"></i></div>
    <div class="gate-slab gate-slab-l door-leaf door-leaf-l" aria-hidden="true"><i class="gate-shade"></i></div>
    <div class="gate-slab gate-slab-r door-leaf door-leaf-r" aria-hidden="true"><i class="gate-shade"></i></div>
    {/* the seam: the light between the shut leaves, the length of the door */}
    <i class="gate-seam" aria-hidden="true"></i>
    {/* the light answering: it rakes the concrete either side of the seam, a half on each leaf */}
    <div class="gate-flare gate-flare-l" aria-hidden="true"><i></i></div>
    <div class="gate-flare gate-flare-r" aria-hidden="true"><i></i></div>
    {/* the leaves' lit edges, as one group: they come up when the light runs the length of the seam, and leave with
        their leaves. When a light hands over to the home page's own edge, a copy of that edge is added to this group
        and the two are summed (the script) */}
    <div class="gate-lights" aria-hidden="true">
      <div class="gate-edge gate-edge-l"><i></i></div>
      <div class="gate-edge gate-edge-r"><i></i></div>
    </div>
    {/* the club's sign in the seam: its aura, and its needle with the core (pictures of their own, so each can arrive
        on its own: gate.css, Arriving). In the artwork's own units; gate.css sets the picture's box so that the
        needle stands on the seam and the spur on the L's foot */}
    <div class="gate-sign" aria-hidden="true">
      <svg class="gate-sign-aura" viewBox={SIGN_BOX} focusable="false" set:html={art.aura} />
      <div class="gate-sign-blade"><svg viewBox={SIGN_BOX} focusable="false" set:html={art.sign + art.core} /></div>
    </div>
    <div class="wall-name gate-name" aria-hidden="true">
      {/* each half: a box the size of its word, one small picture per letter laid over it (--i: how many letters
          from the seam), and over the letters the light they catch from the sign (.gate-heat: the logo's own
          reflection, an oval of warm light round the L's foot that shows only on the letters; gate.css) */}
      <span class="gate-half gate-half-l" style={`--hw:${nm.hot.width}`}>
        {nm.hot.paths.map((d, i) => <svg viewBox={nm.box(nm.hot.width)} focusable="false" style={`--i:${nm.hot.paths.length - 1 - i}`}><path d={d} /></svg>)}
        <span class="gate-heat" style={`--m:${shape(nm.hot)}`}></span>
      </span>
      <span class="gate-half gate-half-r" style={`--hw:${nm.land.width}`}>
        {nm.land.paths.map((d, i) => <svg viewBox={nm.box(nm.land.width)} focusable="false" style={`--i:${i}`}><path d={d} /></svg>)}
        <span class="gate-heat" style={`--m:${shape(nm.land)}`}></span>
      </span>
    </div>
    <div class="hv-copy gate-copy">
      <h2 id="gate-title" class="hero-tag">{t.gate.title}</h2>
      <p id="gate-text" class="lead hv-lead">{t.gate.text}</p>
      <div class="hv-act">
        <button class="btn btn-crimson" type="button" data-gate-yes>{t.gate.yes}</button>
        <a class="btn btn-line" href={`/${lang}/goodbye/`}>{t.gate.no}</a>
      </div>
    </div>
  </div>
  {/* the small print at the door's foot: the language at the left corner, the privacy policy at the right (on a phone,
      one row where the page's dock will be) */}
  <div class="gate-foot">
    <span class="gate-langs">
      <a href={altPath(path, 'ru')} hreflang="ru" lang="ru" aria-current={lang === 'ru' ? 'true' : undefined}>Рус</a>
      <a href={altPath(path, 'en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>Eng</a>
    </span>
    <a href={`/${lang}/privacy/`}>{t.footer.privacy}</a>
  </div>
</div>
<script>
  // While the question shows, the page behind it is out of reach (inert: the keyboard and screen readers stay in the
  // question; nothing changes on screen) and the question has the focus.
  const root = document.documentElement;
  const gate = document.getElementById('gate');
  const behind = gate && !root.classList.contains('age-ok')
    ? Array.from(document.body.children).filter((el): el is HTMLElement => el !== gate && el instanceof HTMLElement && !el.matches('script, .svg-defs'))
    : [];
  behind.forEach((el) => { el.inert = true; });
  if (behind.length && !gate!.contains(document.activeElement)) gate!.focus({ preventScroll: true });
  // The page behind is not drawn while the door arrives (gate.css). Once the whole arrival is over (the seam has come
  // up along the door, about 2.6 s in) and the browser has a free moment, the page is drawn behind the door, so the
  // answer has nothing left to paint; drawing it earlier cost the arrival its last frames.
  if (behind.length) {
    const set = () => root.classList.add('door-set');
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(set, { timeout: 1200 }) : setTimeout(set, 200));
    if (!root.classList.contains('motion') || root.classList.contains('door-still')) set();
    else setTimeout(idle, 3000);
  }

  // Yes: remember the answer for this visit (Base.astro asks again on the next one), give the page back, and open
  // the door. The page is told it may begin a moment after (motion.ts waits for this), and once the leaves are where
  // they go, .age-ok takes the door away.
  gate?.querySelector('[data-gate-yes]')?.addEventListener('click', () => {
    if (gate.classList.contains('out')) return;
    behind.forEach((el) => { el.inert = false; });
    try { sessionStorage.setItem('age_ok', String(Date.now())); } catch {}
    const begin = () => dispatchEvent(new Event('hotland:gate'));
    if (!root.classList.contains('motion') || typeof gate.animate !== 'function') {
      root.classList.add('age-ok');
      begin();
      return;
    }
    // (how much of the answering light the pointer had already raised: the opening carries on from there)
    const glow = parseFloat(getComputedStyle(gate.querySelector('.gate-flare')!).opacity) || 0;
    gate.classList.add('out');
    setTimeout(begin, 250);
    try {
      open(gate, glow);
    } catch (err) {
      root.classList.add('age-ok');
      console.error(err);
    }
  });

  /* The opening. One movement: p, how far each leaf has gone, eased slow-fast-slow as a heavy door moves. Where
     everything else is follows from p (the lights, the name, the shade a leaf casts), and every piece is given its own
     run of positions, sampled from that one movement, as an animation of transform and opacity only. The browser
     plays those off the main thread, so the door moves evenly even while the page behind it is busy starting up.
       0 ms     the question and the small print go; the light runs the length of the seam (the lit edges come up
                out of the sign, 320 ms, and the sign goes, to 550); the light on the concrete answers
       140      the leaves start (1300 ms). Where the home page's door stands open behind, they open to its leaves
                and their light settles on its lit edges; elsewhere they leave the screen, their light with them
       500      the home page's film comes up inside the gap (hero.css)
       ~1000    (the home page, open) the light gives way to the home page's own: one cross-fade, 440 ms, the two
                always adding up to one light; the leaves give way to the home page's, the same concrete
       1440     the door is taken away (.age-ok) */
  function open(gate: HTMLElement, glow: number) {
    const q = <T extends Element = HTMLElement>(sel: string) => gate.querySelector<T>(sel)!;
    const all = <T extends Element = HTMLElement>(sel: string) => Array.from(gate.querySelectorAll<T>(sel));
    const slabL = q('.gate-slab-l'), slabR = q('.gate-slab-r');
    const edgeL = q('.gate-edge-l'), edgeR = q('.gate-edge-r');
    const [flareL, flareR] = all('.gate-flare');
    const [nameL, nameR] = all('.gate-half');
    const W = gate.clientWidth;
    const shown = (el: Element) => parseFloat(getComputedStyle(el).opacity);

    // What stands behind (see the top of this file): the home page's door, if the page is at its top. aL / aR: how far
    // each leaf travels to stand where the home page's leaf stands (measured at the leaves' inner edges, where the
    // concrete is anchored); 0 where the home page's door is shut.
    const door = scrollY < 2 ? document.querySelector<HTMLElement>('.hero .hv-door') : null;
    const theirLeaves = door ? Array.from(door.querySelectorAll<HTMLElement>('.dr-leaf')) : [];
    const inner = (el: Element | undefined, side: 'l' | 'r') => { const r = el?.getBoundingClientRect(); return r && r.width ? (side === 'l' ? r.right : r.left) : NaN; };
    const aL = inner(slabL, 'l') - inner(theirLeaves[0], 'l');
    const aR = inner(theirLeaves[1], 'r') - inner(slabR, 'r');
    const fits = (a: number) => Number.isFinite(a) && a > -2 && a < W / 2;
    const mode: 'keep' | 'shut' | 'plain' = !door || !fits(aL) || !fits(aR) ? 'plain' : aL > 2 && aR > 2 ? 'keep' : 'shut';
    root.classList.add(mode === 'plain' ? 'gate-plain' : `gate-${mode}`);
    // The name: where the leaves open onto the home page's door, it is carried onto the home page's own name, each
    // half to its place and to its size (the home page's may be the smaller: its LAND has to fit beside the gap).
    // Measured, not worked out: half a pixel off showed as a tick when the door was taken away.
    const theirs = mode === 'keep' ? Array.from(door!.querySelectorAll('.dr-half')) : [];
    const onto = (mine: Element, to: Element | undefined, guess: number) => {
      const m = mine.getBoundingClientRect(), t = to?.getBoundingClientRect();
      const x = t ? t.left + t.width / 2 - (m.left + m.width / 2) : NaN, y = t ? t.top + t.height / 2 - (m.top + m.height / 2) : NaN;
      const s = t && m.width ? t.width / m.width : NaN;
      return [x, y, s].every(Number.isFinite) && s > 0.4 && s < 1.6 && Math.abs(x) < W / 2 && Math.abs(y) < gate.clientHeight / 2 ? { x, y, s } : { x: guess, y: 0, s: 1 };
    };
    const nL = onto(nameL, theirs[0], -aL), nR = onto(nameR, theirs[1], aR);
    const dimR = shown(nameR) || 1; // (LAND stands a step dimmer on the door: gate.css)

    // The one movement, sampled.
    const START = 140, LASTS = 1300, STEPS = 56;
    const travel = W / 2 + 110;
    const heavy = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const P = Array.from({ length: STEPS + 1 }, (_, i) => travel * heavy(i / STEPS));
    const c01 = (v: number) => Math.min(1, Math.max(0, v));
    // how far along the opening is, 0 to 1 (where the leaves only go as far as the home page's, they take the same
    // eased movement over their shorter way)
    const k = (p: number) => p / travel;
    const ride = W * 0.14 + 50; // how far a light that leaves is carried before it has gone out
    const running: Animation[] = [];
    const run = (el: Element | null | undefined, frames: Keyframe[], timing: KeyframeAnimationOptions) => {
      if (el) running.push(el.animate(frames, { fill: 'both', ...timing }));
    };
    /** One piece through the movement: where it is (x, and y and its size s where those change) and how much of it
     *  shows (o) at each sampled p. */
    const play = (el: Element | undefined, at: (p: number) => { x?: number; y?: number; s?: number; o?: number }) => {
      run(el, P.map((p) => {
        const { x, y = 0, s = 1, o } = at(p);
        const f: Keyframe = {};
        if (x !== undefined) f.transform = `translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,0)${s === 1 ? '' : ` scale(${s.toFixed(5)})`}`;
        if (o !== undefined) f.opacity = o.toFixed(3);
        return f;
      }), { duration: LASTS, delay: START, easing: 'linear' });
    };
    const out = 'cubic-bezier(.22, .61, .36, 1)';
    // the leaves (and the light raking the concrete, which is on them)
    if (mode === 'keep') {
      play(slabL, (p) => ({ x: -aL * k(p) }));
      play(slabR, (p) => ({ x: aR * k(p) }));
      play(flareL, (p) => ({ x: -aL * k(p) }));
      play(flareR, (p) => ({ x: aR * k(p) }));
      // standing where the home page's leaves stand, they give way to them: the same concrete, so only what the home
      // page's leaves carry and these do not (the hours, the header over the lintel) comes up
      [slabL, slabR].forEach((el) => run(el, [{ opacity: 1 }, { opacity: 0 }], { duration: 440, delay: START + LASTS - 440, easing: 'ease-in-out' }));
    } else if (mode === 'plain') {
      play(slabL, (p) => ({ x: -p }));
      play(slabR, (p) => ({ x: p }));
      play(flareL, (p) => ({ x: -p }));
      play(flareR, (p) => ({ x: p }));
      all('.gate-shade').forEach((el) => play(el, (p) => ({ o: Math.min(1, p / 40) })));
    }
    // the floor: where the door opens, the room's light comes onto it (the home page's floor) or the page does
    run(q('.gate-floor'), [{ opacity: 1 }, { opacity: 0 }], mode === 'keep' ? { duration: 900, delay: START + 120, easing: 'ease-in-out' } : { duration: 600, delay: START, easing: 'ease-in' });

    const lights = q('.gate-lights');
    const copies = new Set<Element>();
    const light = (edge: HTMLElement, dir: number, a: number, own: HTMLElement | undefined) => {
      if (mode === 'plain' || !own) { play(edge, (p) => ({ x: dir * p, o: 1 - c01((p - 16) / ride) })); return; }
      play(edge, (p) => ({ x: dir * a * k(p) }));
      // Standing on the home page's lit edge, it gives way to it: one cross-fade. The home page's edge takes part as a
      // copy of itself inside the door's own group of lights, added to the door's light rather than laid over it
      // (plus-lighter), so the two are one light all the way: it neither doubles nor dips, it only changes from the
      // door's edge into the home page's. The original stays out of sight until the door is taken away; the copy
      // stands exactly on it, so that moment shows nothing.
      const swap = { duration: 440, delay: START + LASTS - 440, easing: 'ease-in-out' };
      run(edge, [{ opacity: 1 }, { opacity: 0 }], swap);
      if (copies.has(own)) return;
      copies.add(own);
      const r = own.getBoundingClientRect(), g = lights.getBoundingClientRect();
      const copy = own.cloneNode(true) as HTMLElement;
      Object.assign(copy.style, {
        position: 'absolute', display: 'block', margin: '0', left: `${r.left - g.left}px`, top: `${r.top - g.top}px`, width: `${r.width}px`, height: `${r.height}px`,
        right: 'auto', bottom: 'auto', mixBlendMode: 'plus-lighter', willChange: 'opacity',
      });
      lights.append(copy);
      run(copy, [{ opacity: 0 }, { opacity: 1 }], swap);
      run(own, [{ opacity: 0 }, { opacity: 0 }], { duration: START + LASTS });
    };
    const theirEdges = mode === 'keep' ? theirLeaves.map((l) => l.querySelector<HTMLElement>('.door-edge') ?? undefined) : [];
    if (mode !== 'shut') {
      light(edgeL, -1, aL, theirEdges[0]);
      light(edgeR, 1, aR, theirEdges[1]);
    }
    // The name. Where the leaves open onto the home page's door it goes with them, to the home page's own name, and
    // LAND comes up to full (the light the letters took from the sign goes with the sign, below). Where they leave, it
    // leaves with them, sinking into the dark as it goes.
    const carry = (to: { x: number; y: number; s: number }, u: number) => ({ x: to.x * u, y: to.y * u, s: 1 + (to.s - 1) * u });
    if (mode === 'keep') {
      play(nameL, (p) => carry(nL, k(p)));
      play(nameR, (p) => ({ ...carry(nR, k(p)), o: dimR + (1 - dimR) * k(p) }));
    } else if (mode === 'plain') {
      const sink = (p: number) => 1 - c01((p - W * 0.12) / (W * 0.3));
      play(nameL, (p) => ({ x: -p, o: sink(p) }));
      play(nameR, (p) => ({ x: p, o: dimR * sink(p) }));
    }
    // The home page's door, shut: the question's door gives way to it where it stands (the same door, shut, which
    // says when the club opens), once the answering light has run the seam's length.
    if (mode === 'shut') run(q('.gate-in'), [{ opacity: 1 }, { opacity: 0 }], { duration: 1000, delay: START + LASTS - 1000, easing: 'ease-in-out' });

    // Around it: the question goes (from wherever it is: "Yes" may be pressed before it has finished arriving), and
    // the light answers along the seam: on the leaves, so it leaves with them, and out before the lights have settled.
    // The light runs the length of the seam: the two lit edges come up out of the sign, growing from the name to
    // their full length, while the sign itself goes, and with it the light the letters took from it and the seam.
    const sign = q('.gate-sign');
    run(lights, [{ opacity: 0, transform: 'scaleY(.3)' }, { opacity: 1, transform: 'scaleY(1)' }], { duration: 320, easing: out });
    [sign, q('.gate-seam')].forEach((el) => run(el, [{ opacity: shown(el) }, { opacity: 0 }], { duration: 460, delay: 90, easing: 'ease-in' }));
    all('.gate-heat').forEach((el) => run(el, [{ opacity: shown(el) }, { opacity: 0 }], { duration: 460, delay: 90, easing: 'ease-in' }));
    const copy = q('.gate-copy'), foot = q('.gate-foot');
    run(copy, [{ opacity: 1, transform: 'translate3d(0,0,0)' }, { opacity: 0, transform: 'translate3d(0,8px,0)' }], { duration: 240, easing: 'cubic-bezier(.55, .06, .68, .19)' });
    run(foot, [{ opacity: shown(foot) }, { opacity: 0 }], { duration: 240, easing: 'ease-in' });
    [flareL, flareR].forEach((el) => run(el, [{ opacity: glow, easing: out }, { opacity: 1, offset: 0.45, easing: 'ease-in-out' }, { opacity: 0 }], { duration: 660 }));

    let over = false;
    const done = () => {
      if (over) return;
      over = true;
      clearTimeout(guard);
      root.classList.add('age-ok');
      // (the home page's own edges go back to being simply there)
      running.forEach((a) => { const el = (a.effect as KeyframeEffect | null)?.target; if (el && !gate.contains(el)) a.cancel(); });
    };
    // (if the tab is put away mid-way and the frames stop, the door still goes)
    const guard = setTimeout(done, 3200);
    Promise.all(running.map((a) => a.finished)).then(done, done);
  }
</script>

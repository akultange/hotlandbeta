---
// The gallery in brief (the home page's «Галерея», data/variants.ts 'gallery': v2; styles in styles/filmstrip.css): a
// row of the gallery's prints, cut from the newspaper as every photograph on the site is (styles/cut.css: the torn
// edge, the white fibre, the dot screen, each at its own slight tilt). They stand side by side on one line from the
// page's left margin and run off the screen at the right. As the page scrolls the row slides sideways past you, from
// its first prints to its last, and a finger laid on it moves it too (with reduced motion it stays, a row to scroll
// by hand). Under the mouse a print straightens and plays its film if it has one (on phones, the print that settles
// in view plays). Each print opens the gallery.
// (Until 2026-11-22 it was a strip of half-frame 35 mm film, the pictures in its frames between the sprocket holes;
// it became prints when every photograph on the site was cut from the newspaper. Its motion stayed.)
import { photo } from '../data/images';
import { type Lang } from '../data/i18n';
import { galleryPhotos } from '../data/gallery';

interface Props { lang: Lang; href: string; next?: Record<string, string> }
const { href, next = {} } = Astro.props;
// eight prints (a phone shows the first six: filmstrip.css), the club's places among the artists: the stage, the
// dressing room, the pole, a table, the curtain, the bar
const names = [
  'bar-menu-entry', 'gal-06-dressing-room', 'gal-01-pole-red-smoke', 'bar-menu-kitchen',
  'gal-15-behind-the-curtain', 'gal-03-on-the-bar', 'gal-09-duet-curtain', 'gal-12-corset-chair',
];
const prints = names
  .map((name) => galleryPhotos.find((s) => s.src.includes(`/${name}.`)))
  .filter((s): s is (typeof galleryPhotos)[number] => Boolean(s));
const sets = await Promise.all(prints.map((s) => photo(s.thumb ?? s.src, '(max-width: 699px) 64vw, (max-width: 899px) 40vw, 24vw')));
/** A picture's width over its height, from its ratio ('2/3'): the print's width in the row (filmstrip.css). */
const rn = (r: string) => { const [a, b] = r.split('/').map(Number); return (a / b).toFixed(4); };
---
<div class="gfs" data-gfs>
  <div class="gfs-run" data-lenis-prevent-horizontal>
    <ol class="gfs-row" role="list" data-gfs-strip>
      {prints.map((s, i) => (
        <li class="gfs-item" style={`--rn:${rn(s.ratio)}`}>
          <a class="gfs-a" href={href} tabindex="-1" aria-hidden="true" {...next}>
            <span class="photo gfs-ph" style={`aspect-ratio:${s.ratio}`} data-loop={s.film}>
              <img src={s.thumb ?? s.src} {...sets[i]} alt="" loading="lazy" decoding="async" draggable="false" />
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // With motion (.is-live): as the row passes through the screen it slides sideways, from its first print on the
  // page's left margin to its last on the right margin, at about the page's own pace (no faster: the client found
  // a faster strip too much; a phone's row is six prints long so that it gets there: filmstrip.css). A finger laid
  // on it moves it too: a sideways drag adds to where the scroll has brought it, between its two ends, and it glides
  // on a little when let go; an up-and-down drag stays the page's own scroll (touch-action: pan-y; the browser then
  // cancels ours). Without motion nothing here runs: the row is one to scroll by hand (filmstrip.css).
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-gfs]').forEach((box) => {
    const run = box.querySelector<HTMLElement>('.gfs-run');
    const strip = box.querySelector<HTMLElement>('[data-gfs-strip]');
    if (!run || !strip) return;
    if (still || !document.documentElement.classList.contains('motion')) return;
    // the page's margin, as the row has it before the script takes over (its own padding, var(--pad))
    let pad = parseFloat(getComputedStyle(run).paddingLeft) || 16;
    box.classList.add('is-live');

    // where the row stands: `at`, where the page's scroll has brought it, plus `off`, what a finger has added
    const st = { at: 0, off: 0 };
    let first = 0, last = 0; // its two ends: the first print on the left margin, the last on the right margin
    const measure = () => {
      const W = box.clientWidth;
      // (on a screen wider than the page's column, the margin is the column's)
      const edge = Math.max(pad, (W - 1440) / 2 + pad);
      first = edge;
      last = Math.min(first, W - edge - strip.scrollWidth);
    };
    const draw = () => {
      const x = Math.min(first, Math.max(last, st.at + st.off));
      // (what would run past an end is let go, so the row answers at once when the scroll or the finger turns back)
      st.off = x - st.at;
      gsap.set(strip, { x });
    };
    measure();
    st.at = first;
    draw();
    gsap.fromTo(st, { at: () => { measure(); return first; } }, {
      at: () => { measure(); return last; },
      ease: 'none',
      onUpdate: draw,
      scrollTrigger: { trigger: box, start: 'top bottom', end: 'bottom top', scrub: 0.6, invalidateOnRefresh: true, onRefresh: draw },
    });
    addEventListener('resize', () => {
      // (the margin follows the window: read it again from a probe with the row's own padding)
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;padding-left:var(--pad)';
      box.append(probe);
      pad = parseFloat(getComputedStyle(probe).paddingLeft) || pad;
      probe.remove();
    });

    // the finger (and a pen; a mouse has the scroll, and the prints are links to click)
    let held: { id: number; x: number; moved: boolean } | null = null;
    let glide: gsap.core.Tween | null = null;
    let trail: { t: number; x: number }[] = [];
    let dragEnded = 0;
    run.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || !e.isPrimary) return;
      glide?.kill();
      held = { id: e.pointerId, x: e.clientX, moved: false };
      trail = [{ t: e.timeStamp, x: e.clientX }];
    });
    run.addEventListener('pointermove', (e) => {
      if (!held || e.pointerId !== held.id) return;
      const dx = e.clientX - held.x;
      if (!held.moved && Math.abs(dx) < 6) return; // (a tap wobbles a little: not a drag yet)
      held.moved = true;
      held.x = e.clientX;
      st.off += dx;
      draw();
      trail.push({ t: e.timeStamp, x: e.clientX });
      if (trail.length > 6) trail.shift();
    });
    const letGo = (e: PointerEvent) => {
      if (!held || e.pointerId !== held.id) return;
      const was = held;
      held = null;
      if (!was.moved) return;
      dragEnded = e.timeStamp;
      if (e.type === 'pointercancel' || trail.length < 2) return;
      // it glides on by its last speed, slowing to a stop (nothing springs back)
      const a = trail[0], b = trail[trail.length - 1];
      const v = e.timeStamp - b.t > 90 ? 0 : (b.x - a.x) / Math.max(16, b.t - a.t); // px a millisecond
      if (Math.abs(v) > 0.08) glide = gsap.to(st, { off: st.off + v * 260, duration: 0.8, ease: 'power3.out', onUpdate: draw });
    };
    run.addEventListener('pointerup', letGo);
    run.addEventListener('pointercancel', letGo);
    // a drag is not a tap: the print under the finger does not open the gallery
    run.addEventListener('click', (e) => {
      if (e.timeStamp - dragEnded < 400) { e.preventDefault(); e.stopPropagation(); }
    }, true);
  });
</script>

---
import { photo } from '../data/images';
import { type Lang, ui, tr } from '../data/i18n';
import { site } from '../data/site';
import FooterCard from './FooterCard.astro';
import FooterNight from './FooterNight.astro';
import FooterClassic from './FooterClassic.astro';
import VariantSwitch from './VariantSwitch.astro';
import { choosing, show } from '../data/variants';
import { closing } from '../data/content';
import { keepShort } from '../data/format';
// cta: the closing "your table is waiting" block; pages that end in a form of their own leave it out
const { lang, cta = true } = Astro.props as { lang: Lang; cta?: boolean };
const t = ui[lang];
const ru = lang === 'ru';
const p = (s: string) => `/${lang}/${s}/`;
const invite = await photo('/media/invite-table.webp', '100vw');
---
<footer class:list={['ft', { 'no-cta': !cta }]}>
  <div class="wrap">
    {cta && (
      <div class="ft-cta" data-invite>
        <!-- the hall from a guest's seat: the room dims and a spotlight finds one table by the stage -->
        <div class="invite-room" aria-hidden="true">
          <img src="/media/invite-table.webp" {...invite} alt="" loading="lazy" decoding="async" />
          <span class="invite-dim"></span>
          <span class="invite-pin"><i></i><b>{ru ? 'Ваш стол' : 'Your table'}</b></span>
        </div>
        <!-- the invitation: the title on the left; the line and the two buttons beside it, so the whole block,
             hall included, fits one screen -->
        <div class="ft-cta-in">
          <p class="t-xl ft-cta-h" set:html={tr(closing.title, lang)} />
          <div class="ft-cta-side">
            <p class="lead" set:html={keepShort(tr(closing.text, lang), lang)} />
            <div class="btns">
              <a class="btn btn-crimson" href={p('booking')}>{t.bookTable}</a>
              <a class="btn btn-line" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- the last screen: the links, the contacts and the small print, never taller than the screen. While the
         client chooses, four takes (data/variants.ts, 'footer'): v4 the calling card, v5 the night's programme,
         and the four columns over Luka's 3D sign or Gio's steel HOTLAND -->
    <div class:list={['ft-host', { 'vx-host': choosing('footer') }]}>
      {show('footer', 'v4') && <div class="vx-part" data-v="footer:v4"><FooterCard lang={lang} /></div>}
      {show('footer', 'v5') && <div class="vx-part" data-v="footer:v5"><FooterNight lang={lang} /></div>}
      {show('footer', 'luka') && <div class="vx-part" data-v="footer:luka"><FooterClassic lang={lang} sign="luka" /></div>}
      {show('footer', 'gio') && <div class="vx-part" data-v="footer:gio"><FooterClassic lang={lang} sign="gio" /></div>}
      <VariantSwitch name="footer" />
    </div>
  </div>
</footer>

<script>
  // The closing invitation: when the hall comes into view the room dims and the spotlight opens on a table.
  const room = document.querySelector<HTMLElement>('[data-invite] .invite-room');
  if (room) {
    const lit = () => room.classList.add('lit');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) lit();
    else {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { lit(); io.disconnect(); } }, { threshold: 0.45 });
      io.observe(room);
    }
  }
</script>

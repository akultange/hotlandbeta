---
// HOTLAND as the wall carries it (the club's brand board), for wherever the name is set small: the header, the
// cards, the footer. Fine steel capitals set wide and evenly, and a blade of red light standing where the L begins,
// so the L grows out of the light. The same lockup as on the 18+ door (data/wordmark.ts, nameHalves), drawn from
// outlines: sharp at any size, and it waits for no font. `height` is the capitals' height in px (or leave it to
// CSS: .name { height }).
import { nameHalves, place } from '../data/wordmark';
interface Props { height?: number; seam?: boolean; label?: boolean; class?: string }
const { height, seam = true, label = false, class: cls } = Astro.props;
const { hot, land, gap, width: W } = nameHalves();
const letters = hot.paths.join('') + land.paths.map((d) => place(d, 1, hot.width + gap, 0)).join('');
// the blade: on the near edge of the L, widest at the capitals' middle, drawn to a point well above and below them
const x = hot.width + gap - 30;
const blade = `M${x} -1290L${x + 24} -357L${x} 575L${x - 24} -357Z`;
---
<svg class:list={['name', cls]} viewBox={`0 -725 ${W} 735`} style={height ? `height:${height}px` : undefined}
  role={label ? 'img' : undefined} aria-label={label ? 'HOTLAND' : undefined} aria-hidden={label ? undefined : 'true'} focusable="false">
  <path class="name-word" d={letters} />
  {seam && <path class="name-seam" d={blade} />}
</svg>

---
// HOTLAND, the club's logo (data/wordmark.ts, LOGO), for wherever the name is set small: the header, the cards, the
// footer. The logo's thin wide capitals in steel, and its sign: a blade of red light standing on the L's stem,
// centred on the line the letters stand on. The same lockup as on the 18+ door, drawn from outlines: sharp at any
// size, and it waits for no font. `height` is the capitals' height in px (or leave it to CSS: .name { height }).
// `short`: the blade's lower point is drawn in, for a small plate (the header's) or a line set close under the name
// (the footer's card).
import { nameHalves, place } from '../data/wordmark';
interface Props { height?: number; seam?: boolean; short?: boolean; label?: boolean; class?: string }
const { height, seam = true, short = false, label = false, class: cls } = Astro.props;
const { hot, land, gap, stem, width: W } = nameHalves();
const letters = hot.paths.join('') + land.paths.map((d) => place(d, 1, hot.width + gap, 0)).join('');
// the blade: on the L's stem, widest where the L's foot leaves it, drawn to a point well above and below the name:
// as the logo's sign, as far below the line the letters stand on as above it. `short` draws the lower point in: in
// the header's plate the blade then stands in the plate's middle and does not cross its edge (the plate is 46px
// tall, the capitals 12px at most: 3px of the plate are left above the blade and under it), and on the footer's
// card it ends above the motto set under the name instead of striking through it.
const x = hot.width + gap + stem / 2;
const w = stem * 0.46;
const blade = `M${x} -1560L${x + w} -40L${x} ${short ? 860 : 1480}L${x - w} -40Z`;
---
<svg class:list={['name', cls]} viewBox={`0 -725 ${W} 735`} style={height ? `height:${height}px` : undefined}
  role={label ? 'img' : undefined} aria-label={label ? 'HOTLAND' : undefined} aria-hidden={label ? undefined : 'true'} focusable="false">
  <path class="name-word" d={letters} />
  {seam && <path class="name-seam" d={blade} />}
</svg>

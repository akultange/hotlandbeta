---
// Finding the club (styles in styles/visit.css): the end of the home page, and the About page's contacts.
// Read top to bottom: the heading, the address, the four facts as a plain list (hours, shows, dress code, entry)
// and the two ways to get here. Beside them a round peephole looks out at the door: its film plays over the
// still while it is in view (a click or tap pauses it; with reduced motion only the still shows until asked).
// Whatever the page puts inside <Visit> sits under the block, in the same section (About: the ways to reach us).
import { photo } from '../data/images';
import { visit, media } from '../data/content';
import { type Lang, ui, tr } from '../data/i18n';
import { site } from '../data/site';
interface Props {
  lang: Lang;
  /** The section's id: "visit" on the home page, "contacts" on About (the old /contacts/ sends visitors there). */
  id?: string;
  /** How many of the facts to list, from the first (all four unless told). */
  facts?: number;
  /** The second button, a call: Luka's "request a call" or Gio's number (shown unless told). */
  call?: boolean;
}
const { lang, id = 'visit', facts: factCount = visit.rows.length, call = true } = Astro.props;
const t = ui[lang];
const ru = lang === 'ru';

// The address: the street, then the city after its last comma ("ул. Примерная, 00" + "Москва"). The comma between
// the two is set apart (.vs-sep): on a phone the city stands on its own line, and a line's end needs no comma.
const addr = site.address[lang];
const cut = addr.lastIndexOf(',');
// No-break spaces keep the house number with its street and "ул." with the name ("ул. Примерная, 00" / "00 Sample").
const street = (cut > 0 ? addr.slice(0, cut) : addr)
  .replace(/(^|\s)(ул\.|пр\.|пер\.|д\.)\s/g, '$1$2\u00a0')
  .replace(/,\s(?=\d)/g, ',\u00a0')
  .replace(/^(\d+)\s/, '$1\u00a0');
const city = cut > 0 ? addr.slice(cut + 1).trim() : '';

// Each fact: its value up to the first comma, the rest as a note under it ("22:00–06:00" + "каждую ночь").
// A value without spaces (a time range) never breaks, not even at its dash.
const facts = visit.rows.slice(0, factCount).map((r) => {
  const all = tr(r.v, lang);
  const i = all.indexOf(',');
  const v = i > 0 ? all.slice(0, i) : all;
  return { k: tr(r.k, lang), v, whole: !/\s/.test(v), note: i > 0 ? all.slice(i + 1).trim() : '' };
});
import VariantSwitch from './VariantSwitch.astro';
import { choosing, show } from '../data/variants';
import '../styles/visit.css';
const door = await photo(media(visit.shot.img), '(max-width: 899px) 74vw, 38vw');
---
<!-- VISIT: one column to read top to bottom (where, when, the rules, the way there) beside the peephole on the door -->
<section class:list={['sec vs', { 'vx-host': choosing('contact') }]} id={id} aria-labelledby={`${id}-h`} data-visit>
  <VariantSwitch name="contact" />
  <div class="wrap vs-wrap">
    <div class="vs-head">
      <h2 class="t-l" id={`${id}-h`} set:html={tr(visit.title, lang)} />
      <p class="vs-addr" style={`--len:${street.length}`}><span class="vs-street">{street}{city && <span class="vs-sep">,</span>}</span>{city && <> <span class="vs-city">{city}</span></>}</p>
    </div>
    <figure class="vs-peep">
      <button class="vs-lens" type="button" data-peep data-pause={ru ? 'Остановить видео' : 'Pause the video'} data-play={ru ? 'Включить видео' : 'Play the video'} aria-label={ru ? 'Остановить видео' : 'Pause the video'}>
        <span class="vs-glass">
          <img src={media(visit.shot.img)} {...door} alt="" loading="lazy" decoding="async" />
          {visit.shot.loop && (
            <video muted loop playsinline preload="none" aria-hidden="true">
              <source src={media(visit.shot.loop)} type="video/mp4" />
            </video>
          )}
        </span>
        <i class="vs-ctl" aria-hidden="true"></i>
      </button>
      <figcaption class="sr-only">{tr(visit.shot.alt, lang)}</figcaption>
    </figure>
    <!-- the four facts as a plain list, in the order a guest asks: when, the show, what to wear, the door -->
    <dl class="vs-facts">
      {facts.map((f) => <div class="vs-fact"><dt>{f.k}</dt><dd><b class:list={{ whole: f.whole }}>{f.v}</b>{f.note && <span>, {f.note}</span>}</dd></div>)}
    </dl>
    <div class="btns vs-btns">
      <a class="btn btn-crimson" href={site.mapUrl} target="_blank" rel="noopener">{t.directions}</a>
      {call && show('contact', 'luka') && <button class="btn btn-line" data-v="contact:luka" type="button" data-contact="callback">{ru ? 'Заказать звонок' : 'Request a call'}</button>}
      {call && show('contact', 'gio') && <a class="btn btn-line" data-v="contact:gio" href={site.phoneHref}>{site.phone}</a>}
    </div>
  </div>
  {Astro.slots.has('default') && <div class="wrap vs-more"><slot /></div>}
</section>

<script>
  // Finding us: the block's entrance, and the film in the peephole.
  const sec = document.querySelector<HTMLElement>('[data-visit]');
  if (sec) {
    const root = document.documentElement;

    // 1. The entrance (visit.css): with motion on, once, when the block comes into view after the 18+ question.
    //    Nothing is hidden unless this runs (.vs-wait), and nothing at all without html.motion. It watches the
    //    block itself, not what a page adds under it (About's ways to reach us), so a long section on a short
    //    screen still gets far enough into view.
    if (root.classList.contains('motion') && 'IntersectionObserver' in window) {
      sec.classList.add('vs-wait');
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        sec.classList.add('vs-on');
        io.disconnect();
      }, { threshold: 0.3 });
      const start = () => io.observe(sec.querySelector('.vs-wrap') || sec);
      const gate = document.getElementById('gate');
      if (!gate || root.classList.contains('age-ok') || gate.classList.contains('out')) start();
      else addEventListener('hotland:gate', start, { once: true });
    }

    // 2. The film plays, muted, over the still while the peephole is in view (it loads only then); a click or
    //    tap pauses it until asked again. With reduced motion, or when the phone asks to save data, it waits
    //    for that click.
    const lens = sec.querySelector<HTMLButtonElement>('[data-peep]');
    const film = lens?.querySelector('video');
    if (lens && film) {
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      let held = saveData || matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sync = () => {
        lens.classList.toggle('paused', film.paused);
        lens.setAttribute('aria-label', (film.paused ? lens.dataset.play : lens.dataset.pause) || '');
      };
      film.addEventListener('playing', () => lens.classList.add('rolling'), { once: true });
      film.addEventListener('play', sync);
      film.addEventListener('pause', sync);
      lens.addEventListener('click', () => {
        held = !film.paused;
        if (film.paused) film.play().catch(() => {});
        else film.pause();
      });
      if ('IntersectionObserver' in window) {
        // (an iPhone in Low Power Mode refuses to start a film without a touch: the next tap starts it)
        let inView = false;
        let refused = false;
        const roll = () => film.play()
          .then(() => { refused = false; })
          .catch((err: DOMException) => { if (err?.name === 'NotAllowedError') refused = true; });
        new IntersectionObserver(([e]) => {
          inView = e.isIntersecting;
          if (!e.isIntersecting) film.pause();
          else if (!held) roll();
        }, { threshold: 0.35 }).observe(lens);
        addEventListener('touchend', () => { if (refused && inView && !held && film.paused) roll(); }, { passive: true });
      }
      sync();
    }
  }
</script>

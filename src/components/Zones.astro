---
// The club's zones (VIP page; styles in styles/zones.css): a look through the keyhole. The rooms are named down
// the left in large type, outlined until one is chosen; the chosen room shows through a tall keyhole, its light
// spilling round the keyhole's edge, and its colour washes the whole section behind, blurred. The names and the
// keyhole stay on screen with their heading (it holds still with them, right above the names, as close as every
// section's heading is to what it heads), while the page scrolls on: each stretch of scrolling opens the next room
// (the hall, the box by the stage, the VIP room, karaoke, the hookah lounge), a thin crimson line under the open
// one showing how far through it you are, and after the last room the page moves on. Tapping or tabbing to a
// name scrolls to that room. Each room's link names what you book there (`cta`: the table, the box, the room,
// the lounge) and opens the booking form with its own choice made (`book`). A film plays in the keyhole for
// the rooms that have one. Without scripts the section is simply the first room open.
import { photo } from '../data/images';
import { type Lang, tr } from '../data/i18n';
import { zones, media } from '../data/content';
import { keepShort } from '../data/format';
import '../styles/zones.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
// where each picture's subject sits, so the narrow keyhole frames her: the crop, and a zoom towards her (how much,
// and the point it grows from), so every girl's face is in the round top of the keyhole, at one height. The VIP
// room's girl leans low on her sofa: her picture comes closer from its lower right corner, which lifts her into it.
const FOCUS = ['47% 50%', '50% 46%', '100% 50%', '42% 42%', '50% 42%'];
const ZOOM: [number, string][] = [[1, '50% 50%'], [1, '50% 50%'], [1.45, '100% 100%'], [1, '50% 50%'], [1, '50% 50%']];
// the opening the room is seen through: a doorway with a round head (viewBox 0 0 100 160). Until 2026-11-19 it was a
// keyhole; the club asked for a gentlemen's club's language, and the site's own picture is the door. (The names in
// the code and the styles still say "keyhole".)
const KEY = 'M9 157L9 48A41 41 0 0 1 91 48L91 157Z';
const keyMask = `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 160' preserveAspectRatio='none'><path d='${KEY}'/></svg>`)}")`;
const ambient = await Promise.all(zones.map((z) => photo(media(z.img), '100vw')));
---
<section class="zn" id="zones" aria-labelledby="zones-h" data-zones style={`--n:${zones.length}`}>
  <div class="zn-track">
  <div class="zn-stage">
  <div class="zn-amb" aria-hidden="true">
    {zones.map((z, i) => <img class:list={['zn-amb-i', { on: i === 0 }]} data-i={i} src={media(z.img)} {...ambient[i]} alt="" loading="lazy" decoding="async" />)}
  </div>
  <div class="wrap">
    <h2 class="t-l zn-h" id="zones-h">{ru ? 'Зоны клуба' : 'The club’s zones'}</h2>
  </div>
  <div class="wrap zn-in">
    <div class="zn-grid">
      <ol class="zn-list">
        {zones.map((z, i) => (
          <li class:list={['zn-item', { on: i === 0 }]} data-i={i}>
            <button class="zn-name" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`zn-d${i}`}>{tr(z.title, lang)}</button>
            <div class="zn-detail" id={`zn-d${i}`}>
              <div>
                <p class="zn-text" set:html={keepShort(tr(z.text, lang), lang)} />
                <a class="lnk" href={`/${lang}/booking/?type=${z.book}`}>{tr(z.cta, lang)}</a>
              </div>
            </div>
            <span class="zn-bar" aria-hidden="true"><i></i></span>
          </li>
        ))}
      </ol>
      <div class="zk" aria-hidden="true">
        <div class="zk-glow"></div>
        <div class="zk-win" style={`-webkit-mask-image:${keyMask};mask-image:${keyMask}`}>
          {zones.map((z, i) => (
            <div class:list={['zk-shot', { on: i === 0 }]} data-i={i}>
              <img src={media(z.img)} alt="" loading="lazy" decoding="async" style={`object-position:${FOCUS[i] ?? '50% 50%'};--zs:${ZOOM[i]?.[0] ?? 1};transform-origin:${ZOOM[i]?.[1] ?? '50% 50%'}`} />
              {z.loop && <video muted loop playsinline preload="none" data-src={media(z.loop)} style={`object-position:${FOCUS[i] ?? '50% 50%'}`}></video>}
            </div>
          ))}
          <span class="zk-shade"></span>
        </div>
        <svg class="zk-rim" viewBox="0 0 100 160" preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="zk-steel" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity=".9" />
              <stop offset=".35" stop-color="#fff" stop-opacity=".28" />
              <stop offset=".6" stop-color="#fff" stop-opacity=".55" />
              <stop offset="1" stop-color="#c05a6a" stop-opacity=".5" />
            </linearGradient>
          </defs>
          <path d={KEY} fill="none" stroke="url(#zk-steel)" stroke-width="1.4" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
    </div>
  </div>
  </div>
  </div>
</section>

<script>
  // One room on show at a time: the name filled in, its line and link open, its picture in the keyhole and behind
  // the section. Which one is the scroll's choice: the section is a tall track and its stage stays on screen
  // (sticky) while the page goes through it, each room getting an equal stretch. Tapping or tabbing to a name
  // scrolls to the middle of that room's stretch, so the scroll and the room on show never disagree.
  const sec = document.querySelector<HTMLElement>('[data-zones]');
  if (sec) {
    const track = sec.querySelector<HTMLElement>('.zn-track')!;
    const stage = sec.querySelector<HTMLElement>('.zn-stage')!;
    const items = Array.from(sec.querySelectorAll<HTMLElement>('.zn-item'));
    const shots = Array.from(sec.querySelectorAll<HTMLElement>('.zk-shot'));
    const amb = Array.from(sec.querySelectorAll<HTMLElement>('.zn-amb-i'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = items.length;
    let active = 0, seen = false, raf = 0;
    sec.classList.add('pinned');
    // (an iPhone in Low Power Mode refuses to start a film without a touch: the next tap starts the one refused)
    let refused = -1;
    const film = (i: number, play: boolean) => {
      const v = shots[i]?.querySelector<HTMLVideoElement>('video');
      if (!v) return;
      if (play && !reduce) {
        if (v.dataset.src && !v.src) v.src = v.dataset.src;
        v.play()
          .then(() => { if (refused === i) refused = -1; v.classList.add('on'); })
          .catch((err: DOMException) => { if (err?.name === 'NotAllowedError') refused = i; });
      } else {
        if (refused === i) refused = -1;
        v.pause();
        v.classList.remove('on');
      }
    };
    addEventListener('touchend', () => { if (refused >= 0) film(refused, true); }, { passive: true });
    const show = (i: number) => {
      if (i === active) return;
      film(active, false);
      items.forEach((it, k) => {
        it.classList.toggle('on', k === i);
        it.querySelector('.zn-name')?.setAttribute('aria-expanded', String(k === i));
      });
      shots.forEach((s, k) => s.classList.toggle('on', k === i));
      amb.forEach((a, k) => a.classList.toggle('on', k === i));
      active = i;
      if (seen) film(i, true);
    };
    // how far the page is through the track: 0 as the stage settles at the top, 1 as it is about to leave
    const run = () => Math.max(1, track.offsetHeight - stage.offsetHeight);
    const progress = () => Math.min(1, Math.max(0, -track.getBoundingClientRect().top / run()));
    const place = () => {
      raf = 0;
      const s = progress() * n;
      const i = Math.min(n - 1, Math.floor(s));
      show(i);
      sec.style.setProperty('--zp', Math.min(1, s - i).toFixed(3));
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(place); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(place); });
    place();
    // a name chosen by tap, click or keyboard: go to the middle of its stretch (with a mouse, Lenis glides there)
    const goTo = (i: number) => {
      const top = scrollY + track.getBoundingClientRect().top + ((i + 0.5) / n) * run();
      scrollTo({ top: Math.round(top), behavior: reduce ? 'auto' : 'smooth' });
    };
    items.forEach((it, i) => {
      const name = it.querySelector<HTMLButtonElement>('.zn-name');
      name?.addEventListener('click', () => { if (i !== active || progress() <= 0 || progress() >= 1) goTo(i); });
      name?.addEventListener('keyup', (e) => { if (e.key === 'Tab') goTo(i); });
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        seen = e.isIntersecting;
        film(active, seen);
      }, { threshold: 0.35 }).observe(stage);
    }
  }
</script>

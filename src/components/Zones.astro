---
// The club's zones (membership page; styles in styles/zones.css): a plain list on black, the way a good hotel lists
// its rooms. «Между», 2026-11-21: the doorway with its photographs, the room's colour washing the wall and the
// stage held on screen while the page scrolled through it are gone; the rooms are named, numbered and booked, and
// nothing else. Each row: the room's number in the Dial, large and hairline; its name and its one line in the text
// face; and the link that opens the booking form with its own choice made (`book`), whose words name what you book.
// The whole row answers to the pointer, and a line of light runs along its rule.
import { type Lang, tr } from '../data/i18n';
import { zones } from '../data/content';
import { keepShort } from '../data/format';
import '../styles/zones.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const pad2 = (n: number) => String(n).padStart(2, '0');
---
<section class="sec zones" id="zones" aria-labelledby="zones-h">
  <div class="wrap">
    <div class="bighead bh-line">
      <h2 class="t-l" id="zones-h">{ru ? 'Зоны клуба' : 'Inside the club'}</h2>
    </div>
    <ol class="rows zones-list">
      {zones.map((z, i) => (
        <li class="row zone">
          <span class="zone-no" aria-hidden="true">{pad2(i + 1)}</span>
          <h3 class="zone-name">{tr(z.title, lang)}</h3>
          <p class="zone-text" set:html={keepShort(tr(z.text, lang), lang)} />
          <a class="lnk zone-go" href={`/${lang}/booking/?type=${z.book}`}>{tr(z.cta, lang)}<span class="sr-only">: {tr(z.title, lang)}</span></a>
        </li>
      ))}
    </ol>
  </div>
</section>

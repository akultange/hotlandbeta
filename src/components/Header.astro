---
// Header (2026-11-20, fourth take). Desktop: one bar the width of the window with the club's flower at its centre.
// The sections stand either side of it in the footer's order, Home and the next two on the left and the other
// three on the right. The language is at the far left and "Book" at the far right. A hairline runs the full width
// along the bar's lower edge, and the current section is lit on it: a short tube of the red light under the word,
// which glows up into the bar and a little onto the page below and warms the word itself. Under the mouse, a faint
// silver light glides along the line from link to link. Over the top of a page the bar is clear, only its line
// across; once the page moves under it, the bar fills with smoked glass.
// Phones: the flower at the centre and "Menu" on the right, over the same line. The menu is a full-screen sheet:
// the language, the flower and the cross on its top row (where the header's row was), then the sections in big
// type (the current one lit the same way), booking, address, hours and contacts.
import { type Lang, ui, altPath } from '../data/i18n';
import { site } from '../data/site';
import Flower from './Flower.astro';
import Ic from './FooterIcon.astro';
interface Props { lang: Lang; solid?: boolean }
const { lang } = Astro.props;
const t = ui[lang];
const ru = lang === 'ru';
const path = Astro.url.pathname;
// About and Contacts are one page now (/about/, with #contacts); /contacts/ redirects there
// (the show page, /artists/, is hidden at the client's request: pages/[lang]/_artists.astro)
const keys = ['program', 'vip', 'menu', 'gallery', 'about'] as const;
// (the membership page's key is still vip, as in the strings; its address is /membership/)
const items = keys.map((k) => ({ k, href: `/${lang}/${k === 'vip' ? 'membership' : k}/`, label: t.nav[k] }));
const active = (href: string) => path.startsWith(href);
const home = path === `/${lang}/`;
// the header's six, Home first; the flower stands between the third and the fourth
const links = [
  { href: `/${lang}/`, label: ru ? 'Главная' : 'Home', on: home },
  ...items.map((i) => ({ href: i.href, label: i.label, on: active(i.href) })),
];
const [left, right] = [links.slice(0, 3), links.slice(3)];
const hours = `${site.hours[0].open}–${site.hours[0].close}`;
const homeLabel = `${site.name}, ${ru ? 'главная' : 'home'}`;
const langs = [
  { code: 'ru', label: 'Рус', href: altPath(path, 'ru') },
  { code: 'en', label: 'Eng', href: altPath(path, 'en') },
] as const;
import { show } from '../data/variants';
---
<header class="hdr" id="hdr">
  <span class="hdr-bar" aria-hidden="true"></span>
  <div class="hdr-in">
    <div class="seg hdr-lang" role="group" aria-label={ru ? 'Язык' : 'Language'}>
      {langs.map((l) => <a href={l.href} class:list={{ on: lang === l.code }} hreflang={l.code} lang={l.code} aria-current={lang === l.code ? 'true' : undefined}>{l.label}</a>)}
    </div>
    <nav class="hdr-nav" aria-label={ru ? 'Разделы' : 'Sections'}>
      <span class="hdr-hl" aria-hidden="true"></span>
      <div class="hdr-links hdr-links-l">
        {left.map((l) => (
          <a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? 'page' : undefined}>
            {l.on && <span class="hdr-light" aria-hidden="true"></span>}<span class="hdr-tx">{l.label}</span>
          </a>
        ))}
      </div>
      <a class="hdr-name" href={`/${lang}/`} aria-label={homeLabel}><Flower /></a>
      <div class="hdr-links hdr-links-r">
        {right.map((l) => (
          <a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? 'page' : undefined}>
            {l.on && <span class="hdr-light" aria-hidden="true"></span>}<span class="hdr-tx">{l.label}</span>
          </a>
        ))}
      </div>
    </nav>
    <div class="hdr-r">
      <a class="btn btn-sm hdr-book" href={`/${lang}/booking/`}>{t.book}</a>
      <button class="hdr-menu" type="button" aria-expanded="false" aria-controls="mnav" data-open><span>{t.menuOpen}</span><i aria-hidden="true"></i></button>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" hidden data-lenis-prevent role="dialog" aria-modal="true" aria-label={t.menuOpen}>
  <div class="mnav-top">
    <div class="seg" role="group" aria-label={ru ? 'Язык' : 'Language'}>
      {langs.map((l) => <a href={l.href} class:list={{ on: lang === l.code }} hreflang={l.code} lang={l.code} aria-current={lang === l.code ? 'true' : undefined}>{l.label}</a>)}
    </div>
    <a class="hdr-name" href={`/${lang}/`} aria-label={homeLabel}><Flower /></a>
    <button class="hdr-menu is-close" type="button" data-close><span>{t.menuClose}</span><i aria-hidden="true"></i></button>
  </div>
  <div class="mnav-body">
    <nav class="mnav-links" aria-label={ru ? 'Разделы' : 'Sections'}>
      <a href={`/${lang}/`} class:list={{ on: home }} aria-current={home ? 'page' : undefined} style="--i:0"><span>{ru ? 'Главная' : 'Home'}</span></a>
      {items.map((i, n) => (
        <a href={i.href} class:list={{ on: active(i.href) }} aria-current={active(i.href) ? 'page' : undefined} style={`--i:${n + 1}`}>
          <span>{i.label}</span>
        </a>
      ))}
    </nav>
    <div class="mnav-info">
      <a class="btn btn-crimson mnav-book" style="--i:8" href={`/${lang}/booking/`}>{t.bookTable}</a>
      <div class="mnav-visit" style="--i:9">
        <p>{site.address[lang]}</p>
        <p>{ru ? 'Каждую ночь' : 'Nightly'} {hours}</p>
        {show('contact', 'gio') && <a class="mnav-phone" data-v="contact:gio" href={site.phoneHref}>{site.phone}</a>}
      </div>
      <div class="mnav-msg" style="--i:10">
        {show('contact', 'luka') && <button class="glass" type="button" data-contact="callback" data-v="contact:luka"><Ic name="phone" />{ru ? 'Заказать звонок' : 'Request a call'}</button>}
        {show('contact', 'luka') && <button class="glass" type="button" data-contact="question" data-v="contact:luka"><Ic name="ask" />{ru ? 'Задать вопрос' : 'Ask a question'}</button>}
        <a class="glass" href={site.whatsapp} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5 4.8 16A8.6 8.6 0 1 1 8 19.3z" /><path d="M9.3 8.3c.3-.4.9-.4 1.2 0l.8 1.5c.2.3.1.7-.1 1l-.5.5c.6 1.2 1.5 2.1 2.7 2.7l.5-.5c.3-.2.7-.3 1-.1l1.5.8c.4.3.4.9 0 1.2-.6.6-1.5.9-2.4.7-2.4-.6-4.3-2.5-4.9-4.9-.2-.9.1-1.8.7-2.4z" /></svg>
          {t.whatsapp}
        </a>
        <a class="glass" href={site.telegram} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 3.6 2.9 10.4c-.8.3-.8 1.4 0 1.7l4.4 1.6 1.7 5.4c.2.7 1.1.9 1.6.4l2.5-2.4 4.4 3.2c.6.4 1.4.1 1.6-.6l3-14.6c.2-.9-.7-1.6-1.5-1.5z" /><path d="m7.3 13.7 9.4-6.2-6.6 7.4" /></svg>
          {t.telegram}
        </a>
      </div>
      <a class="mnav-careers" style="--i:11" href={`/${lang}/careers/`}>{t.footer.careers}<span aria-hidden="true">→</span></a>
    </div>
  </div>
</div>

<script>
  const root = document.documentElement;

  // 1. The bar: clear over the top of the page, smoked glass once the page moves under it.
  const hdr = document.getElementById('hdr');
  if (hdr) {
    let queued = false;
    const tint = () => { queued = false; hdr.classList.toggle('is-scrolled', scrollY > 2); };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(tint); } }, { passive: true });
    tint();
  }

  // 2. Desktop sections: a faint light on the line snaps to the link under the mouse (or the keyboard focus). It
  //    moves link to link, never with the pointer itself, and fades when the pointer leaves. (It waits a moment
  //    before fading, so that crossing the flower from one side to the other is one glide, not a fade and a jump.)
  const nav = document.querySelector<HTMLElement>('.hdr-nav');
  const hl = nav?.querySelector<HTMLElement>('.hdr-hl');
  if (nav && hl) {
    let shown = false;
    let fading = 0;
    const place = (a: HTMLElement) => {
      hl.style.setProperty('--x', `${a.offsetLeft}px`);
      hl.style.setProperty('--w', `${a.offsetWidth}px`);
    };
    const moveTo = (a: HTMLElement) => {
      clearTimeout(fading);
      if (!shown) {
        hl.classList.add('jump'); // appear in place, then glide from there
        place(a);
        void hl.offsetWidth;
        hl.classList.remove('jump');
      } else place(a);
      hl.classList.add('on');
      shown = true;
    };
    const hide = () => {
      clearTimeout(fading);
      hl.classList.remove('on');
      shown = false;
    };
    const hideSoon = () => { clearTimeout(fading); fading = window.setTimeout(hide, 220); };
    nav.querySelectorAll<HTMLAnchorElement>('.hdr-links a').forEach((a) => {
      a.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') moveTo(a); });
      a.addEventListener('pointerleave', hideSoon);
      a.addEventListener('focus', () => { if (a.matches(':focus-visible')) moveTo(a); });
    });
    nav.addEventListener('focusout', (e) => { if (!nav.contains(e.relatedTarget as Node | null)) hide(); });
  }

  // 3. Phone menu.
  const mnav = document.getElementById('mnav');
  const opener = document.querySelector<HTMLButtonElement>('[data-open]');
  let closing = 0;
  const setOpen = (open: boolean, instant = false) => {
    if (!mnav) return;
    clearTimeout(closing);
    if (open) {
      mnav.classList.remove('closing');
      mnav.hidden = false;
    } else if (!instant && root.classList.contains('motion')) {
      // the sheet lifts away like a curtain before it goes
      mnav.classList.add('closing');
      closing = window.setTimeout(() => { mnav.hidden = true; mnav.classList.remove('closing'); }, 340);
    } else {
      mnav.hidden = true;
      mnav.classList.remove('closing');
    }
    document.body.style.overflow = open ? 'hidden' : '';
    // (while the sheet is open, the header under it is no part of its own in a page change: nav.css)
    root.classList.toggle('mnav-open', open);
    opener?.setAttribute('aria-expanded', String(open));
    dispatchEvent(new CustomEvent('menu:toggle', { detail: open })); // motion.ts pauses smooth scrolling
    if (instant) return;
    if (open) mnav.querySelector<HTMLElement>('[data-close]')?.focus();
    else opener?.focus();
  };
  opener?.addEventListener('click', () => setOpen(true));
  mnav?.querySelector('[data-close]')?.addEventListener('click', () => setOpen(false));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mnav && !mnav.hidden) setOpen(false); });
  // Keep the keyboard inside the open sheet.
  mnav?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const stops = Array.from(mnav.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => el.getClientRects().length);
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  // Close the menu if the window grows past the phone layout.
  matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches && mnav && !mnav.hidden) setOpen(false); });
  // Coming back with the browser's Back button: the page returns as it was left, so shut the sheet at once.
  addEventListener('pageshow', (e) => { if (e.persisted && mnav && !mnav.hidden) setOpen(false, true); });
  // Fetch the menu's 3D icons once the page has settled, so they are there when the sheet opens.
  if (mnav && matchMedia('(max-width: 899px)').matches) {
    const warm = () => mnav.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => { img.loading = 'eager'; });
    const later = () => ('requestIdleCallback' in window ? requestIdleCallback(warm, { timeout: 3000 }) : setTimeout(warm, 1500));
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });
  }
</script>

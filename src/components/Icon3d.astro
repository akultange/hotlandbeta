---
// The 3D icons (chrome and crimson: a stiletto, cherries, lips, a key…) were retired on 2026-11-19: the club asked
// for a gentlemen's club's language, not a strip club's, and the brand is concrete, steel and one line of red
// light. Where a small icon marked a choice or a link, the words now stand alone. Where one big icon held a moment
// (the thank-you page, the 404), the brand's own mark stands in: the line of red light, upright, as it stands in the
// wall's seam (2px, its ends dying away, one soft glow; no rhombus, no stacked glows).
// The component keeps its name and props, so every place that used an icon still builds; the pictures themselves
// stay in public/img/icons. It carries the mark's own look (the old .moment-ic and .blade rules in global.css are
// no longer used).
interface Props {
  name: 'stiletto' | 'cherries' | 'coupe' | 'lips' | 'peach' | 'mic' | 'pole' | 'key' | 'keyhole' | 'emblem';
  size?: number;
  alt?: string;
  eager?: boolean;
  class?: string;
}
const { class: cls = '' } = Astro.props;
const moment = cls.split(' ').includes('moment-ic');
---
{moment && <span class="seam-mark" aria-hidden="true"></span>}

<style>
  /* (the ends fade in the line's own gradient, not under a mask: a mask would cut the glow off with them) */
  .seam-mark {
    display: block; width: 2px; height: clamp(104px, 13vw, 168px); margin: 0 auto;
    background: linear-gradient(180deg, transparent, var(--light) 28%, var(--light) 72%, transparent);
    filter: drop-shadow(0 0 10px rgba(255, 43, 61, .55));
  }
  /* it is struck once, growing from its middle */
  @media (prefers-reduced-motion: no-preference) { .seam-mark { animation: seam-mark-in 1s var(--ease-out) both; } }
  @keyframes seam-mark-in { from { opacity: 0; scale: 1 .25; } }
</style>
